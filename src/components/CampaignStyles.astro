  .campaign-archive-toggle:has(:disabled) { opacity:.5;cursor:not-allowed; }
  .campaign-archive-tooltip { position:absolute;top:calc(100% + 4px);right:0;z-index:10;width:280px;padding:10px 12px;border-radius:var(--r-md);background:var(--ink);color:var(--surface);font-size:var(--fs-sm);line-height:1.5;box-shadow:var(--shadow-overlay);visibility:hidden;opacity:0;transition:opacity var(--dur-1) var(--ease-out); }
  .campaign-archive-option:hover .campaign-archive-tooltip,.campaign-archive-option:focus-within .campaign-archive-tooltip { visibility:visible;opacity:1; }
