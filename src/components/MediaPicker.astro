---
import MediaBrowser from './MediaBrowser.astro';
interface Props { base: string; id?: string }
const { base, id = 'media-picker' } = Astro.props;
---
<dialog class="media-picker-dialog" data-media-picker aria-labelledby={`${id}-title`}>
  <header class="media-picker-heading"><h2 id={`${id}-title`}>Choose media</h2><a href={`${base}/media`} target="_blank" rel="noopener" aria-label="Open Media page in a new tab">Open Media page<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 3h7v7M21 3 10 14M10 3H3v18h18v-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></header>
  <MediaBrowser picker idPrefix={id} />
  <footer class="media-picker-footer"><span data-picker-count>0 / 3 selected</span><button class="secondary" type="button" data-picker-cancel>Cancel</button><button class="primary" type="button" data-picker-apply>Use selected media</button></footer>
</dialog>
<style is:global>
  .media-picker-dialog { width:min(840px,calc(100vw - 32px));max-height:calc(100dvh - 32px);padding:24px;border:1px solid var(--line);border-radius:12px;color:var(--ink);background:var(--surface); }
  .media-picker-dialog[open] { display:flex;flex-direction:column;overflow:hidden; }
  .media-picker-dialog>.media-browser { min-height:0;overflow-y:auto; }
  .media-picker-heading,.media-picker-footer { flex-shrink:0; }
  .media-picker-dialog::backdrop { background:rgb(32 42 38 / 40%); }
  .media-picker-heading { display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px; }
  .media-picker-heading h2 { margin:0!important; }
  .media-picker-heading a { display:inline-flex;align-items:center;gap:6px;font-size:.8125rem;min-height:44px; }.media-picker-heading a svg { width:16px;height:16px;flex-shrink:0; }
  .media-picker-footer { display:flex;justify-content:flex-end;align-items:center;gap:8px;flex-wrap:wrap;margin-top:20px; }
  .media-picker-footer>span { margin-right:auto;font-size:.8125rem;color:var(--muted); }
  @media(max-width:760px) { .media-picker-dialog { padding:16px; }.media-picker-footer>span { width:100%; }.media-picker-heading a { max-width:12ch;text-align:right; } }
</style>
