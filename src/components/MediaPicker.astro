---
import MediaBrowser from './MediaBrowser.astro';
interface Props { base: string; id?: string }
const { base, id = 'media-picker' } = Astro.props;
---
<dialog class="media-picker-dialog" data-media-picker aria-labelledby={`${id}-title`}>
  <header class="media-picker-heading"><h2 id={`${id}-title`}>Choose media</h2><a href={`${base}/media`} target="_blank" rel="noopener" aria-label="Open Media page in a new tab">Open Media page<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3h7v7M21 3 10 14M10 3H3v18h18v-7"/></svg></a></header>
  <MediaBrowser picker idPrefix={id} />
  <footer class="media-picker-footer"><span data-picker-count>0 / 3 selected</span><button class="secondary" type="button" data-picker-cancel>Cancel</button><button class="primary" type="button" data-picker-apply>Use selected media</button></footer>
</dialog>
<style is:global>
  .media-picker-dialog[open] { display:flex;flex-direction:column;overflow:hidden; }
  .media-picker-dialog>.media-browser { min-height:0;overflow-y:auto; }
  .media-picker-heading,.media-picker-footer { flex-shrink:0; }
  .media-picker-heading h2 { font-size:var(--fs-lg); }
  .media-picker-heading a { display:inline-flex;align-items:center;gap:6px;min-height:44px;font-size:var(--fs-sm);font-weight:600; }
  .media-picker-heading a svg { width:16px;height:16px; }
  .media-picker-footer>span { margin-right:auto;color:var(--ink-2);font-size:var(--fs-sm); }
  @media(max-width:760px) { .media-picker-footer>span { width:100%; }.media-picker-heading a { max-width:12ch;text-align:right; } }
</style>
