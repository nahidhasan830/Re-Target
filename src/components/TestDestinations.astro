---
import LoadingRegion from './LoadingRegion.astro';
---
<section class="test-destinations" aria-labelledby="test-destinations-title" data-test-settings>
  <header class="destinations-header">
    <div><h2 id="test-destinations-title">Test destinations</h2><p>Preview campaigns on numbers you control.</p></div>
    <span id="test-number-count" class="chip plain number-count" aria-label="Test numbers used">0 / 10</span>
  </header>
  <LoadingRegion id="test-settings-loading" variant="destinations" label="Loading test destinations…">
  <form id="test-settings">
    <div class="destinations-fields">
      <label for="test-numbers">WhatsApp numbers</label>
      <textarea id="test-numbers" name="numbers" rows="3" placeholder="01XXXXXXXXX" required spellcheck="false" aria-describedby="test-numbers-help"></textarea>
      <p id="test-numbers-help" class="field-hint field-help">Up to 10 numbers, one per line.</p>
      <p class="field-hint field-help account-note">Available to every campaign in your account.</p>
    </div>
    <div class="destinations-actions"><button class="primary" type="submit">Verify and save</button><p id="test-settings-message" role="status"></p></div>
  </form>
  </LoadingRegion>
  <button class="secondary" id="retry-test-settings" type="button" hidden>Retry loading numbers</button>
</section>
<script>
  import { initTestSettings } from '../lib/campaign-ui';
  initTestSettings();
</script>
<style>
  .test-destinations { display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--surface); }
  .test-destinations :global(#test-settings-loading) { display:flex;flex-direction:column;flex:1; }
  .test-destinations :global(#test-settings-loading > .region-skeleton) { padding:24px; }
  .test-destinations :global(#test-settings-loading > .region-content) { display:flex;flex-direction:column;flex:1; }
  .test-destinations :global(#test-settings-loading[aria-busy=true] > .region-content) { display:none; }
  #retry-test-settings { align-self:flex-start;margin:0 24px 24px; }
  .destinations-header { display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:18px 24px;border-bottom:1px solid var(--line); }
  h2 { font-size:var(--fs-lg); }
  .destinations-header p { margin-top:4px;color:var(--ink-2);font-size:var(--fs-sm); }
  .test-destinations:has(:global(#test-settings-loading[aria-busy=true])) .number-count { visibility:hidden; }
  form { display:flex;flex:1;flex-direction:column;min-width:0; }
  .destinations-fields { display:flex;flex:1;flex-direction:column;gap:6px;padding:20px 24px; }
  textarea { flex:1;min-height:150px;line-height:1.8; }
  .account-note { margin-top:2px; }
  .destinations-actions { display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;padding:16px 24px;border-top:1px solid var(--line); }
  #test-settings-message { color:var(--success);font-size:var(--fs-sm);overflow-wrap:anywhere; }
  #test-settings-message:empty { display:none; }
  #test-settings-message.error { color:var(--danger); }
  @media(max-width:760px) { .destinations-header { padding:16px; }.destinations-fields { padding:16px; }.destinations-actions { padding:14px 16px; }textarea { min-height:132px; } }
</style>
