---
import PasswordToggle from './PasswordToggle.astro';
interface Props { error?: string; minimum?: number; label?: string }
const { error, minimum = 10, label = 'Password' } = Astro.props;
---
<div class="field">
  <label for="password">{label}</label>
  <div class="password-wrap">
    <input id="password" name="password" type="password" autocomplete="new-password" required minlength={minimum} maxlength="128" aria-invalid={error ? 'true' : undefined} aria-describedby="password-error" />
    <PasswordToggle controls="password" />
  </div>
  <p class="field-error" id="password-error" aria-live="polite" hidden={!error}>{error}</p>
  <p class="field-hint">At least 10 characters.</p>
</div>
