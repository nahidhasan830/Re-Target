---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import CampaignDetail from './CampaignDetail.astro';
import CampaignEditor from './CampaignEditor.astro';
interface Props { base:string;id?:string;view?:string;phone:string;role:'admin'|'user';companyName:string }
const {base,id='',view='audience',phone,role,companyName}=Astro.props;
---
<DashboardLayout title={id ? 'Campaign' : 'New campaign'} active="campaigns" phone={phone} role={role} companyName={companyName}>
  <span slot="header-meta" id="detail-campaign-status" class="campaign-header-status" hidden={!id}></span>
  <div slot="header-actions" id="campaign-controls" class="campaign-controls" hidden={!id}></div>
  <a slot="header-leading" href={`${base}/campaigns`} class="campaign-header-back" aria-label="Back to campaigns" title="Back to campaigns"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7M5 12h14" /></svg></a>
  {id ? <CampaignDetail base={base} id={id} view={view} owner={phone} /> : <CampaignEditor base={base} companyName={companyName} view={view} owner={phone} />}
</DashboardLayout>
