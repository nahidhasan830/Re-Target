---
import RefreshIcon from './RefreshIcon.astro';
import Icon from './Icon.astro';
interface Props { picker?: boolean; idPrefix?: string }
const { picker = false, idPrefix } = Astro.props;
const prefix = idPrefix ?? (picker ? 'picker' : 'library');
---
<div class="media-browser" data-media-browser data-picker={String(picker)}>
  <form class="media-filters" role="search">
    <label class="field media-search" for={`${prefix}-search`}>Search media<input id={`${prefix}-search`} name="search" type="search" placeholder="Search by filename" maxlength="120" autofocus={picker} /></label>
    <label class="field" for={`${prefix}-kind`}>Type<select id={`${prefix}-kind`} name="kind"><option value="all">All media</option><option value="image">Images</option><option value="video">Videos</option></select></label>
    <button class="icon-button toolbar-icon media-refresh" type="button" data-media-refresh aria-label="Refresh media" title="Refresh media"><RefreshIcon /></button>
  </form>
  <p class="media-feedback" data-media-feedback role="status"></p>
  <div class="media-grid" data-media-grid aria-label={picker ? 'Choose media' : 'Media files'}></div>
  <div class="media-empty empty-state" data-media-empty hidden><span class="empty-mark" aria-hidden="true"><Icon name="media" /></span><h2 data-empty-title>No media yet</h2><p data-empty-copy>Upload images and videos to use in your campaigns.</p></div>
  <footer class="media-pagination" data-media-pagination><span data-media-count></span><div><button class="secondary" type="button" data-media-previous>Previous</button><button class="secondary" type="button" data-media-next>Next</button></div></footer>
</div>
<style is:global>
  .media-browser { display:flex;flex:1;flex-direction:column;gap:12px;min-width:0; }
  .media-filters { display:flex;align-items:end;gap:10px; }
  .media-filters .media-search { flex:1;max-width:480px; }
  .media-filters label:not(.media-search) { min-width:150px; }
  .media-filters .media-refresh { margin-left:auto;border:1px solid var(--line-strong); }
  .media-refresh[aria-busy=true] svg { animation:spin .8s linear infinite; }
  .media-feedback { color:var(--ink-2);font-size:var(--fs-sm); }
  .media-feedback:empty { display:none; }
  .media-feedback.error { color:var(--danger); }
  .media-grid { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-content:start;gap:14px; }
  .media-card { min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--surface);transition:border-color var(--dur-1) var(--ease-out),box-shadow var(--dur-1) var(--ease-out); }
  .media-card:hover { border-color:var(--line-strong); }
  .media-card[data-selected=true] { border-color:var(--current);box-shadow:0 0 0 1px var(--current);background:var(--current-soft); }
  .media-thumbnail { position:relative;display:block;width:100%;max-height:144px;aspect-ratio:16/9;padding:0;overflow:hidden;border:0;border-bottom:1px solid var(--line);background:var(--surface-3);color:var(--ink-2);cursor:pointer; }
  .media-thumbnail img,.media-thumbnail video { display:block;width:100%;height:100%;object-fit:contain; }
  .media-thumbnail>span { display:grid;place-items:center;height:100%;font-size:var(--fs-sm); }
  .media-thumbnail:focus-visible { outline-offset:-3px; }
  .media-video-mark { position:absolute;left:8px;bottom:8px;display:flex;align-items:center;gap:4px;padding:2px 7px;border-radius:var(--r-xs);background:rgb(18 26 47 / .78);color:#fff;font-size:var(--fs-xs);font-weight:600; }
  .media-video-mark svg { width:14px;height:14px; }
  .media-card-body { padding:10px; }
  .media-card h3 { overflow:hidden;font-size:var(--fs-sm);font-weight:600;line-height:1.5;text-overflow:ellipsis;white-space:nowrap; }
  .media-card p { margin:1px 0;overflow:hidden;color:var(--ink-3);font-size:var(--fs-xs);text-overflow:ellipsis;white-space:nowrap; }
  .media-card-actions { display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px; }
  .media-card-actions .secondary { padding-inline:12px;font-size:var(--fs-sm); }
  .media-preview svg { width:18px;height:18px; }
  .media-card-actions .media-delete { display:grid;place-items:center;min-width:44px;min-height:44px;padding:0; }
  .media-delete svg { width:18px;height:18px; }
  .media-in-use { color:var(--ink-3);font-size:var(--fs-xs); }
  .media-select { width:100%; }
  .media-select[aria-pressed=true] { border-color:var(--current);background:var(--current-soft);color:var(--current); }
  .media-empty { flex:1;align-content:center;min-height:280px; }
  .media-pagination { display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;padding-top:8px;color:var(--ink-2);font-size:var(--fs-sm); }
  .media-pagination>div { display:flex;gap:8px; }
  .media-browser[data-picker=true] .media-grid { grid-template-columns:repeat(3,minmax(0,1fr));gap:12px; }
  @media(max-width:1100px) { .media-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  @media(max-width:760px) { .media-grid,.media-browser[data-picker=true] .media-grid { grid-template-columns:repeat(2,minmax(0,1fr));gap:10px; }.media-filters { flex-wrap:wrap;gap:8px; }.media-filters .media-search { flex:1 1 100%;max-width:none; }.media-filters label:not(.media-search) { flex:1;min-width:0; }.media-pagination { flex-wrap:wrap; }.media-pagination>div { margin-left:auto; }.media-card-actions .secondary { padding-inline:8px; } }
</style>
