---
import { courierProviders, courierFields, courierNames } from '../lib/courier-validation';
import type { CourierSettingsState } from '../lib/courier-settings';
import SuccessFeedback from './SuccessFeedback.astro';
import PasswordToggle from './PasswordToggle.astro';
interface Props { state: CourierSettingsState; action: string; saved: string | null }
const { state, action, saved } = Astro.props;
---

<p class="form-message form-error" role="alert" hidden={!state.message}>{state.message}</p>
<div class="courier-grid">
  {courierProviders.map((provider) => {
    const form = state.forms[provider];
    return <section class="courier-panel" aria-labelledby={`${provider}-title`}>
      <header class="courier-header"><h2 id={`${provider}-title`}>{courierNames[provider]}</h2><span class="chip credential-status" data-tone={form.connected ? 'success' : form.saved ? 'info' : form.legacy ? 'warning' : undefined}>{form.connected ? 'Connected' : form.saved ? 'Saved' : form.legacy ? 'Update login' : 'Not set up'}</span></header>
      <form method="post" action={action} data-courier-form={provider} data-saved={String(form.saved)} data-connected={String(form.connected)}>
        <input type="hidden" name="provider" value={provider} />
        <div class="courier-fields">
          {courierFields[provider].map((field) => {
            const id = `${provider}-${field.name}`;
            const error = form.errors[field.name];
            return <div class="field">
              <label for={id}>{field.label}</label>
              <div class:list={{ 'password-wrap': field.secret }}>
                <input id={id} name={field.name} type={field.secret ? 'password' : field.type ?? 'text'} autocomplete={field.secret ? 'new-password' : 'off'} value={field.secret ? undefined : form.values[field.name]} placeholder={field.secret && form.saved ? 'Saved · enter to replace' : undefined} required={!field.secret || !form.saved} maxlength={field.maximum} spellcheck="false" autocapitalize="none" aria-invalid={error ? 'true' : undefined} aria-describedby={`${id}-error`} />
                {field.secret && <PasswordToggle controls={id} subject={`${courierNames[provider]} ${field.label.toLowerCase()}`} />}
              </div>
              <p class="field-error" id={`${id}-error`} hidden={!error}>{error}</p>
            </div>;
          })}
          {form.legacy && <p class="field-hint">Enter your merchant login to replace the saved API keys.</p>}
        </div>
        <p class="form-message form-error" role="alert" hidden={!form.message}>{form.message}</p>
        <div class="form-footer"><button class="primary" type="submit" name="intent" value={form.message && form.saved ? 'reconnect' : 'connect'} disabled={Boolean(state.message) || form.connected} data-idle={form.connected ? 'Update connection' : form.message && form.saved ? 'Reconnect' : 'Connect'}>{form.connected ? 'Update connection' : form.message && form.saved ? 'Reconnect' : 'Connect'}</button>
          <p class="save-status" role="status" aria-atomic="true"><SuccessFeedback label={Astro.url.searchParams.get('connected') === provider && form.connected ? 'Connected' : 'Saved'} message={Astro.url.searchParams.get('connected') === provider && form.connected ? 'Courier connected.' : saved === provider && form.saved ? 'Credentials saved.' : ''} /></p></div>
      </form>
    </section>;
  })}
</div>
<script>
  import { validateCourier, type CourierProvider, type CourierErrors } from '../lib/courier-validation';
  import { setFeedback } from '../lib/feedback';
  document.querySelectorAll<HTMLFormElement>('[data-courier-form]').forEach((form) => {
    form.noValidate = true;
    const provider = form.dataset.courierForm as CourierProvider;
    const buttons = Array.from(form.querySelectorAll<HTMLButtonElement>('button[type="submit"]'));
    const status = form.querySelector<HTMLElement>('.save-status')!;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[name]:not([type="hidden"])'));
    let busy = false;
    const initialValues = fields.map(field => field.value);
    const unchanged = () => form.dataset.connected === 'true' && fields.every((field, index) => field.value === initialValues[index]);
    const validate = () => validateCourier(provider, Object.fromEntries(fields.map((field) => [field.name, field.value])), form.dataset.saved === 'true');
    const showErrors = (errors: CourierErrors) => fields.forEach((field) => {
      const error = errors[field.name];
      field.setAttribute('aria-invalid', String(Boolean(error)));
      const message = document.getElementById(`${field.id}-error`)!;
      message.textContent = error ?? ''; message.hidden = !error;
    });
    fields.forEach((field) => field.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') showErrors(validate().errors);
      buttons.forEach(button => { button.disabled = busy || Boolean(document.querySelector('main > .form-message:not([hidden])')) || unchanged(); });
      if (!busy) setFeedback(status, '');
      form.querySelector<HTMLElement>('.form-message')!.hidden = true;
    }));
    form.addEventListener('submit', (event) => {
      if (busy) { event.preventDefault(); return; }
      const result = validate(); showErrors(result.errors);
      if (!result.valid) { event.preventDefault(); fields.find((field) => result.errors[field.name])?.focus(); return; }
      const submitter = event.submitter as HTMLButtonElement | null;
      const intent = submitter?.value ?? 'connect';
      const action = document.createElement('input'); action.type = 'hidden'; action.name = 'intent'; action.value = intent; action.dataset.pendingIntent = ''; form.appendChild(action);
      busy = true; buttons.forEach(button => { button.disabled = true; });
      if (submitter) submitter.textContent = 'Connecting…';
      setFeedback(status, 'Connecting to your courier…'); form.setAttribute('aria-busy', 'true');
    });
    window.addEventListener('pageshow', () => {
      if (busy) setFeedback(status, '');
      busy = false; buttons.forEach(button => { button.disabled = Boolean(document.querySelector('main > .form-message:not([hidden])')) || unchanged(); button.textContent = button.dataset.idle!; });
      form.querySelector('[data-pending-intent]')?.remove(); form.removeAttribute('aria-busy');
    });
  });
  document.querySelector<HTMLInputElement>('[aria-invalid="true"]')?.focus();
</script>
<style>
  :global(main) > .form-message { margin-bottom: 16px; }
  .courier-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .courier-panel { display: flex; flex-direction: column; min-width: 0; padding: 22px 24px 24px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); }
  .courier-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  h2 { font-size: var(--fs-lg); }
  form { display: flex; flex: 1; flex-direction: column; gap: 16px; margin-top: 18px; }
  .courier-fields { display: grid; flex: 1; align-content: start; gap: 16px; }
  .form-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding-top: 4px; }
  .save-status:empty { display: none; }
  @media (max-width: 760px) { .courier-grid { grid-template-columns: 1fr; gap: 16px; } .courier-panel { padding: 18px 16px 20px; } .form-footer .primary { flex: 1; } .save-status { flex-basis: 100%; } .save-status:has(.success-feedback) { flex-basis: auto; } }
</style>
