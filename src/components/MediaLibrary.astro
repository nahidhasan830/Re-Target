---
import MediaBrowser from './MediaBrowser.astro';
import Icon from './Icon.astro';
---
<section class="media-page" data-media-library>
  <section class="media-upload-panel" aria-labelledby="media-upload-title">
    <div class="media-upload-content">
      <span class="empty-mark media-upload-icon" aria-hidden="true"><Icon name="upload" /></span>
      <div class="media-upload-heading"><h2 id="media-upload-title">Upload media</h2><p>Upload once. Use in any campaign.</p></div>
      <label class="primary media-upload-button">Choose files<input type="file" aria-label="Choose files to upload" data-media-files accept="image/jpeg,image/png,video/mp4" multiple /></label>
      <div class="media-upload-limits"><span>JPEG / PNG · up to 5 MB</span><span>MP4 · up to 100 MB</span></div>
      <div class="media-upload-state" data-upload-state hidden><span data-upload-label role="status"></span><progress data-upload-progress max="100" value="0" aria-label="Upload progress"></progress></div>
      <p data-upload-feedback role="status" class="media-feedback"></p>
    </div>
  </section>
  <section class="media-library-panel" aria-labelledby="media-library-title">
    <h2 id="media-library-title">Your media</h2>
    <MediaBrowser />
  </section>
  <dialog class="media-preview-dialog" data-media-preview aria-labelledby="media-preview-title"><header><h2 id="media-preview-title"></h2><button type="button" class="icon-button" data-preview-close aria-label="Close preview" autofocus><Icon name="close" /></button></header><div data-preview-content></div></dialog>
  <dialog class="media-delete-dialog" data-media-delete aria-labelledby="media-delete-title"><h2 id="media-delete-title">Delete media?</h2><p data-delete-name></p><p data-delete-error role="status" class="media-feedback error"></p><footer><button class="secondary" type="button" data-delete-cancel autofocus>Keep media</button><button class="danger media-delete-confirm" type="button" data-delete-confirm>Delete media</button></footer></dialog>
</section>
<script>
  import { initMediaLibrary } from '../lib/media-ui';
  initMediaLibrary();
</script>
<style is:global>
  main:has(>.media-page) { display:flex; }
  .media-page { display:grid;flex:1;grid-template-columns:minmax(0,1fr);gap:20px;min-width:0; }
  .media-upload-panel,.media-library-panel { min-width:0;padding:22px 24px;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--surface); }
  .media-upload-panel { display:grid;place-items:center; }
  .media-upload-content { display:flex;flex-direction:column;align-items:center;gap:14px;width:100%;max-width:320px;text-align:center; }
  .media-upload-icon.empty-mark { width:88px;height:88px;margin:0 0 4px; }
  .media-upload-icon.empty-mark svg { width:26px;height:26px; }
  .media-upload-heading h2,.media-library-panel>h2 { font-size:var(--fs-lg); }
  .media-upload-heading p { margin-top:4px;color:var(--ink-2);font-size:var(--fs-sm); }
  .media-library-panel { display:flex;flex-direction:column;gap:14px; }
  .media-upload-button { position:relative;overflow:hidden;width:100%; }
  .media-upload-button input { position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer; }
  .media-upload-button:focus-within { outline:2px solid var(--focus);outline-offset:2px; }
  .media-upload-button:has(input:disabled) { opacity:.7;cursor:wait; }
  .media-upload-limits { display:grid;gap:2px;color:var(--ink-3);font-size:var(--fs-xs); }
  .media-upload-state { display:grid;gap:8px;width:100%;font-size:var(--fs-sm);overflow-wrap:anywhere; }
  .media-upload-content>.media-feedback { overflow-wrap:anywhere; }
  .media-upload-state progress { width:100%;height:6px;overflow:hidden;border:0;border-radius:3px;background:var(--surface-3);accent-color:var(--current);appearance:none; }
  .media-upload-state progress::-webkit-progress-bar { background:var(--surface-3); }
  .media-upload-state progress::-webkit-progress-value { background:var(--current); }
  .media-upload-state progress::-moz-progress-bar { background:var(--current); }
  .media-page .media-filters .media-search { max-width:none;min-width:0; }
  .media-page .media-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .media-page .media-pagination { padding-top:14px;border-top:1px solid var(--line); }
  @media(min-width:1101px) {
    .media-page { grid-template-columns:minmax(280px,1fr) minmax(0,2fr); }
    main:has(>.media-page) { min-height:calc(100dvh - var(--topbar-h)); }
  }
  @media(min-width:1101px) and (max-width:1359px) { .media-page .media-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(min-width:1101px) and (min-height:600px) { main:has(>.media-page) { flex:none; }.media-page { min-height:var(--content-h); } }
  @media(min-width:761px) and (max-width:1100px) {
    .media-upload-panel { padding:18px 24px; }
    .media-upload-content { display:grid;grid-template-columns:64px minmax(0,1fr) 240px;column-gap:20px;row-gap:8px;max-width:none;text-align:left; }
    .media-upload-icon.empty-mark { grid-row:1/3;width:64px;height:64px;margin:0; }
    .media-upload-heading { grid-row:1/3;align-self:center; }
    .media-upload-limits { display:block;grid-column:3;text-align:center; }
    .media-upload-limits span { display:block; }
    .media-upload-state,.media-upload-content>.media-feedback { grid-column:2/4; }
  }
  @media(min-width:1101px) and (max-height:760px) {
    .media-upload-panel,.media-library-panel { padding:18px 20px; }
    .media-library-panel { gap:12px; }
    .media-page .media-thumbnail { max-height:64px; }
    .media-page .media-browser { gap:10px; }
    .media-page .media-card-body { padding:8px; }
    .media-page .media-grid { gap:12px; }
    .media-page .media-pagination { padding-top:12px; }
  }
  .media-preview-dialog,.media-delete-dialog,.media-picker-dialog { width:min(840px,calc(100vw - 32px));max-width:none;padding:20px 24px 24px; }
  .media-preview-dialog header,.media-picker-heading { display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px; }
  .media-preview-dialog h2,.media-delete-dialog h2 { font-size:var(--fs-lg);overflow-wrap:anywhere; }
  [data-preview-content] img,[data-preview-content] video { display:block;max-width:100%;max-height:70dvh;margin:auto;border-radius:var(--r-md); }
  .media-delete-dialog { width:min(440px,calc(100vw - 32px)); }
  .media-delete-dialog p { margin-top:8px;color:var(--ink-2);overflow-wrap:anywhere; }
  .media-delete-dialog footer,.media-picker-footer { display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:8px;margin-top:20px; }
  @media(max-width:760px) {
    .media-page { gap:16px; }
    .media-upload-panel,.media-library-panel { padding:16px; }
    .media-upload-content { display:grid;grid-template-columns:44px minmax(0,1fr);gap:12px;max-width:none;text-align:left; }
    .media-upload-icon.empty-mark { width:44px;height:44px;margin:0; }
    .media-upload-icon.empty-mark::before { inset:7px; }
    .media-upload-icon.empty-mark svg { width:18px;height:18px; }
    .media-upload-button,.media-upload-limits,.media-upload-state,.media-upload-content>.media-feedback { grid-column:1/-1; }
    .media-upload-limits { display:flex;flex-wrap:wrap;gap:4px 12px; }
    .media-page .media-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .media-page .media-card-actions .media-preview { width:44px;min-width:44px;height:44px;padding:0; }
    .media-page .media-preview span { display:none; }
    .media-preview-dialog,.media-picker-dialog { padding:16px; }
  }
</style>
