---
import DataTable from './DataTable.astro';
import MediaPicker from './MediaPicker.astro';
import { editorSteps, campaignPath } from '../lib/campaign-routes';
import { SEND_INTERVAL_SECONDS, DAILY_SEND_ATTEMPTS } from '../lib/campaign-content';
interface Props { base:string;companyName:string;id?:string;view?:string;owner?:string }
const {base,companyName,id='',view='audience',owner=base}=Astro.props;
const initialStep = Math.max(0, editorSteps.findIndex(step => step === view));
---
<section class="campaign-root campaign-editor" data-campaign-editor data-base={base} data-company={companyName} data-id={id} data-view={view} data-owner={owner}>
  <form id="campaign-form" novalidate>
    <div class="composer-heading">
      <ol class="campaign-steps" aria-label="Campaign steps">
        {['Audience', 'Message', 'Review & schedule'].map((title, index) => <li><button type="button" data-step={index} data-complete={index < initialStep} aria-current={index === initialStep ? 'step' : undefined}><span class="step-marker"><span class="step-number">{index + 1}</span><svg class="step-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg></span><span>{title}</span></button></li>)}
      </ol>
      <a class="secondary campaign-sending-link" id="editor-sending-link" href={campaignPath(base, id, 'sending')} hidden={!id}>Sending</a>
    </div>
    <p id="composer-message" role="status"></p>
    <section data-panel="0" aria-label="Audience" class="audience-layout" hidden={initialStep !== 0}>
      <section class="audience-filter-panel" aria-labelledby="audience-filters-heading">
        <label class="campaign-name-field">Campaign name<input name="name" placeholder="Name this campaign" maxlength="120" required /></label>
        <h2 class="audience-filter-heading" id="audience-filters-heading"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="9" cy="7" r="3" fill="var(--surface)" stroke="currentColor" stroke-width="1.7"/><circle cx="15" cy="17" r="3" fill="var(--surface)" stroke="currentColor" stroke-width="1.7"/></svg>Audience filters</h2>
        <div class="audience-filter-content">
          <div class="audience-filters"><label>Courier<select name="source"><option value="all">All couriers</option><option value="pathao">Pathao</option><option value="steadfast">Steadfast</option></select></label><label>Contact Channel<select name="whatsapp"><option value="yes">WhatsApp</option><option value="imo" disabled>IMO</option><option value="all">All</option></select></label><label>Min. deliveries<input name="minDeliveries" type="number" min="1" max="100000" /></label><label>Min. value (BDT)<input name="minValue" type="number" min="0" step="0.01" /></label></div>
          <p class="campaign-warning" id="audience-warning" hidden></p>
        </div>
      </section>
      <div class="audience-table-panel">
        <div class="audience-heading"><div><h2>Audience</h2><p class="muted" id="selected-audience-note">All matching leads are included</p></div></div>
        <DataTable id="campaign-audience-table" label="Campaign audience"><p slot="empty" class="audience-empty" id="audience-empty" hidden>No leads match these filters.</p></DataTable>
      </div>
    </section>
    <section data-panel="1" aria-label="Message" class="message-panel" hidden={initialStep !== 1}>
      <div class="message-layout">
        <div class="message-fields">
          <div class="message-label-row"><h2><label for="offer-text">Message</label></h2><span class="muted" id="text-length">0 / 4,000 characters</span></div>
          <div class="message-editor">
            <div class="format-toolbar" role="group" aria-label="WhatsApp formatting">
              <button type="button" data-format="bold" aria-label="Bold" title="Bold"><strong>B</strong></button>
              <button type="button" data-format="italic" aria-label="Italic" title="Italic"><em>I</em></button>
              <button type="button" data-format="strike" aria-label="Strikethrough" title="Strikethrough"><s>S</s></button>
              <button type="button" data-format="code" aria-label="Inline code" title="Inline code"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m8 6-6 6 6 6M16 6l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button type="button" id="format-more-toggle" popovertarget="format-more-menu" aria-label="More formatting" title="More formatting"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></button>
            </div>
            <textarea id="offer-text" name="text" rows="6" placeholder="Write your message…"></textarea>
            <div class="personalization-controls" role="group" aria-label="Personalize message"><span>Insert</span><button type="button" data-format="name" aria-label="Insert customer name">Name</button><button type="button" data-format="company" aria-label="Insert company name">Company</button></div>
          </div>
          <div id="format-more-menu" class="format-menu" popover aria-label="More formatting"><button type="button" data-format="mono">Monospace</button><button type="button" data-format="list">List</button><button type="button" data-format="quote">Quote</button></div>
          <div class="message-attachments"><div class="attachment-heading"><div><h3>Attachments</h3><p class="muted">Up to 3 files · <a href={`${base}/media`} target="_blank" rel="noopener">Media library</a></p></div><button class="secondary" type="button" data-open-media-picker><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m8 13 6-6a3 3 0 0 1 4 4l-8 8a5 5 0 0 1-7-7l9-9a7 7 0 0 1 10 10l-9 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>Add media</button></div>
          <ol class="attachment-list" id="attachment-list"></ol>
          <label class="checkbox-row" id="separate-text-option" hidden><input type="checkbox" name="separateText" />Send text as a separate message</label></div>
        </div>
        <aside class="message-preview" aria-labelledby="preview-title">
          <div class="preview-heading"><h3 id="preview-title">Chat preview</h3><label for="sample-name">Preview as</label><input id="sample-name" value="Test customer" maxlength="120" /></div>
          <div id="chat-preview" class="chat-preview" aria-live="polite"></div>
          <p class="muted" id="part-count"></p>
        </aside>
      </div>
    </section>
    <section data-panel="2" aria-label="Review and schedule" class="review-panel" hidden={initialStep !== 2}>
      <div class="review-layout">
        <section class="review-settings" aria-labelledby="review-title">
          <div class="review-panel-heading"><h2 id="review-title">Review your campaign</h2></div>
          <div class="review-settings-body">
            <dl class="review-facts" id="review-facts"></dl>
            <div class="review-schedule">
              <h3>Schedule</h3>
              <div class="schedule-control"><label>Start sending<select name="launchMode" aria-describedby="launch-help"><option value="now">Instant</option><option value="schedule">Schedule for later</option></select></label><p class="muted schedule-help" id="launch-help">Starts sending as soon as the campaign is ready.</p></div>
              <label id="schedule-field" hidden>Start date &amp; time (Dhaka)<input type="datetime-local" name="scheduledAt" aria-describedby="launch-help" /></label>
            </div>
            <ul class="review-delivery-rules muted" aria-label="Sending rules">
              <li>Waits at least {SEND_INTERVAL_SECONDS} seconds between send attempts.</li>
              <li>{DAILY_SEND_ATTEMPTS} attempts per sender/day, including tests and failed sends. Resets at Dhaka midnight. <span id="sending-estimate"></span></li>
              <li>Customers wait 7 days before receiving another campaign. This campaign’s remaining messages still send.</li>
              <li>The customer list and message are fixed at launch. New imports join future campaigns.</li>
            </ul>
          </div>
        </section>
        <section class="review-message" aria-labelledby="review-preview-title">
          <div class="review-panel-heading"><h2 id="review-preview-title">Message preview</h2><span id="review-part-count" class="muted"></span></div>
          <div id="review-preview" class="review-chat" aria-label="Outgoing message sequence"></div>
          <div class="review-test-controls">
            <div class="review-test-heading"><h3>Send a test</h3><a href={`${base}/whatsapp`}>Manage receivers<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></a></div>
            <div class="review-test-row">
              <div class="test-receiver-field"><label for="test-receiver">Test receivers</label><button type="button" id="test-receiver" class="test-receiver-toggle" popovertarget="test-receiver-menu" aria-expanded="false" aria-controls="test-receiver-menu" disabled><span id="test-receiver-label">Loading receivers…</span><span class="test-receiver-count" id="test-receiver-count" hidden></span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></button></div>
              <button class="secondary" id="send-test" type="button" disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 3-7 18-4-7-7-4 18-7ZM10 14l11-11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Send test</span></button>
            </div>
            <div id="test-receiver-menu" class="test-receiver-menu" popover><label class="test-select-all"><input id="test-select-all" type="checkbox" />Select all</label><fieldset id="test-receiver-options"><legend hidden>Test receivers</legend></fieldset><button type="button" class="test-receiver-done" popovertarget="test-receiver-menu" popovertargetaction="hide">Done</button></div>
            <p id="test-send-message" role="status"></p>
            <div id="test-history-slot"></div>
          </div>
        </section>
      </div>
    </section>
    <footer class="composer-actions"><span id="draft-state" class="muted" role="status">Unsaved draft</span><button class="secondary" type="button" id="composer-back" hidden={initialStep === 0}>Back</button><button class="secondary" type="button" id="save-draft">Save draft</button><button class="primary" type="submit" id="composer-next"><span>{initialStep === 2 ? 'Start campaign' : 'Next'}</span><svg data-review-arrow={initialStep === 2} viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></button></footer>
  </form>
  <MediaPicker base={base} />
</section>
<script>
  import { initCampaignEditor } from '../lib/campaign-ui';
  initCampaignEditor();
</script>
<style is:global>
  .campaign-header-back { margin-left:-10px; }
  main:has(> .campaign-editor) { display:flex; }
  main>.campaign-editor { flex:1;display:flex;flex-direction:column;min-height:var(--content-h); }
  #campaign-form { display:flex;flex-direction:column;flex:1;min-height:0;gap:16px; }
  .composer-heading { display:flex;justify-content:center;align-items:center; }
  .campaign-name-field { margin-bottom:12px; }
  .composer-heading { position:relative; }
  #composer-next svg[data-review-arrow=true] { display:none; }
  .campaign-sending-link { position:absolute;right:0;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 12px;font-size:.875rem;text-decoration:none; }
  .campaign-steps { display:flex;align-items:center;list-style:none;padding:0;margin:0; }
  .campaign-steps li { display:flex;align-items:center; }
  .campaign-steps li+li::before { content:'';width:40px;height:2px;margin:0 10px;border-radius:1px;background:var(--line);transition:background-color var(--dur-2) var(--ease-out); }
  .campaign-steps li:has(button[data-complete=true])+li::before { background:var(--success); }
  .campaign-steps button { display:flex;align-items:center;gap:8px;min-height:44px;padding:4px 10px 4px 4px;border:0;border-radius:var(--r-md);background:transparent;color:var(--ink-2);font-size:var(--fs-btn);font-weight:560;white-space:nowrap;cursor:pointer;transition:background-color var(--dur-1) var(--ease-out),color var(--dur-1) var(--ease-out); }
  .campaign-steps button:hover { background:var(--surface-3);color:var(--ink); }
  .step-marker { position:relative;display:grid;place-items:center;width:28px;height:28px;color:var(--ink-3);font-size:var(--fs-xs);font-weight:650; }
  .step-marker::before { content:'';position:absolute;inset:5px;border:1.5px solid var(--line-strong);border-radius:4px;background:var(--surface);transform:rotate(45deg);transition:background-color var(--dur-2) var(--ease-out),border-color var(--dur-2) var(--ease-out); }
  .step-number,.step-check { position:relative; }
  .step-check { display:none;width:13px;height:13px;stroke-width:2.6; }
  .campaign-steps button[aria-current=step] { color:var(--ink);font-weight:650; }
  .campaign-steps button[aria-current=step] .step-marker { color:#fff; }
  .campaign-steps button[aria-current=step] .step-marker::before { border-color:var(--accent);background:var(--accent);box-shadow:0 0 0 3px var(--accent-soft); }
  .campaign-steps button[data-complete=true] .step-marker { color:#fff; }
  .campaign-steps button[data-complete=true] .step-marker::before { border-color:var(--success);background:var(--success); }
  @media (prefers-color-scheme: dark) { .campaign-steps button[data-complete=true] .step-marker { color:var(--ground); } }
  .campaign-steps button[data-complete=true] .step-number { display:none; }
  .campaign-steps button[data-complete=true] .step-check { display:block; }
  .campaign-root #composer-message { margin:0; }
  #composer-message:empty { display:none; }
  .audience-layout { display:grid;grid-template-columns:340px minmax(0,1fr);gap:20px;flex:1;min-height:0; }
  .audience-table-panel { display:flex;flex-direction:column;min-width:0;min-height:280px;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--surface);overflow:hidden; }
  .audience-heading { display:flex;gap:12px;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--line); }
  .campaign-root .audience-heading h2 { margin:0 0 4px;font-size:var(--fs-md); }
  .campaign-root .audience-heading p { margin:0;font-size:var(--fs-sm); }
  .audience-table-panel>.data-table { flex:1;display:flex;flex-direction:column;min-height:0; }
  .audience-table-panel .data-table-body { flex:1;min-height:0; }
  .audience-table-panel .data-table-footer { flex-shrink:0; }
  .audience-table-panel .data-table-error { margin:0;flex-shrink:0; }
  .audience-empty { text-align:center;padding:32px 16px;color:var(--ink-2); }
  .audience-identity { display:flex;flex-direction:column;min-width:0;overflow:hidden; }
  .audience-identity strong { font-weight:600;overflow:hidden;text-overflow:ellipsis; }
  .audience-identity small { display:block;color:var(--ink-2);font-size:var(--fs-2xs);margin-top:4px; }
  .audience-contact { display:inline-flex;align-items:center;gap:6px;color:var(--success); }
  .audience-contact svg { width:20px;height:20px; }
  .audience-filter-panel { min-width:0;align-self:start; }
  .campaign-root .audience-filter-heading { display:flex;align-items:center;gap:8px;font-size:var(--fs-md);min-height:44px;margin:0 0 12px; }
  .audience-filter-heading svg { width:20px;height:20px; }
  .audience-filters input { min-width:0; }
  .audience-filters { display:grid;grid-template-columns:1fr;gap:12px; }
  .audience-filters>label:first-child { grid-column:1 / -1; }
  .campaign-warning { padding:10px 12px;border-radius:var(--r-md);background:var(--warning-soft);color:var(--warning);font-size:var(--fs-sm); }
  .message-panel { display:flex;flex:1; }
  .message-layout { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;align-items:stretch;flex:1;min-width:0; }
  .message-fields { display:flex;flex-direction:column;min-width:0;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--surface); }
  .campaign-root .message-fields h2 { margin:0;font-size:.9375rem; }
  .campaign-root .message-fields h2 label { font:inherit; }
  .message-label-row { display:flex;justify-content:space-between;align-items:center;gap:8px;padding:16px; }
  .campaign-root #text-length { font-size:.75rem;white-space:nowrap;font-variant-numeric:tabular-nums; }
  .message-editor { display:flex;flex-direction:column;flex:1;border-top:1px solid var(--line); }
  .format-toolbar { display:flex;align-items:center;gap:2px;padding:4px 8px;border-bottom:1px solid var(--line);flex-shrink:0; }
  .format-toolbar button,.personalization-controls button,.format-menu button { min-width:44px;min-height:44px;border:0;background:transparent;border-radius:6px;padding:6px 10px;color:var(--ink);cursor:pointer;font:inherit; }
  .format-toolbar button:hover:not(:disabled),.personalization-controls button:hover:not(:disabled),.format-menu button:hover:not(:disabled) { background:var(--surface-3); }
  .format-toolbar button { display:grid;place-items:center;padding:6px;font-size:.9375rem; }
  .format-toolbar svg { width:20px;height:20px; }
  #format-more-toggle { margin-left:auto; }
  .format-menu { position:fixed;inset:auto;width:168px;margin:0;padding:4px;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--surface);color:var(--ink);box-shadow:var(--shadow-overlay); }
  .format-menu:popover-open { display:grid; }
  .format-menu button { text-align:left;font-size:.875rem; }
  .campaign-root #offer-text { display:block;flex:1 1 0;min-height:128px;max-width:100%;border:0;border-radius:0;padding:14px 16px;background:transparent;font-size:.9375rem; }
  #offer-text:focus-visible { outline-offset:-3px; }
  .personalization-controls { flex-shrink:0;display:flex;align-items:center;gap:4px;padding:0 8px;border-top:1px solid var(--line); }
  .personalization-controls>span { margin:0 6px;color:var(--ink-2);font-size:.75rem; }
  .personalization-controls button { color:var(--accent-fg);font-size:var(--fs-sm);font-weight:600; }
  .message-attachments { padding:12px 16px;border-top:1px solid var(--line);flex-shrink:0; }
  .attachment-heading { display:flex;justify-content:space-between;align-items:center;gap:12px; }
  .campaign-root h3 { font-size:.9375rem;margin:12px 0; }
  .campaign-root .attachment-heading h3 { margin:0; }
  .campaign-root .attachment-heading p { margin:2px 0 0;font-size:.75rem; }
  .attachment-heading>button { display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 12px;white-space:nowrap; }
  .attachment-heading svg { width:18px;height:18px; }
  .attachment-list { list-style:none;padding:0;margin:8px 0; }
  .attachment-list:empty { display:none; }
  .attachment-row { display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--line); }
  .attachment-row img,.attachment-row video { width:44px;height:44px;object-fit:cover;border-radius:6px; }
  .attachment-row .attachment-name { flex:1;min-width:0;font-size:var(--fs-sm);overflow-wrap:anywhere; }
  .attachment-actions { display:flex; }
  .checkbox-row { display:flex!important;align-items:center;gap:8px;min-height:44px;font-weight:400!important;margin-top:4px; }
  .message-preview { display:flex;flex-direction:column;min-width:0;overflow-wrap:anywhere;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--surface); }
  .preview-heading { flex-shrink:0;display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:8px 12px;padding:16px; }
  .campaign-root .preview-heading h3 { grid-column:1 / -1;margin:0 0 4px; }
  .campaign-root .preview-heading label { color:var(--ink-2);font-size:var(--fs-sm);font-weight:400; }
  .campaign-root #sample-name { font-size:var(--fs-sm); }
  .chat-preview { display:grid;flex:1;align-content:start;gap:12px;min-height:160px;padding:16px;background:var(--chat); }
  .chat-preview:empty::before { content:'Your message preview will appear here.';align-self:center;color:var(--ink-2);font-size:var(--fs-sm); }
  .chat-bubble { justify-self:end;width:fit-content;max-width:88%;padding:10px 12px;border-radius:10px 10px 2px 10px;background:var(--bubble);color:var(--bubble-ink);font-size:var(--fs-btn);white-space:pre-wrap;overflow-wrap:anywhere;box-shadow:0 1px 1px rgb(0 0 0 / .08); }
  .chat-bubble:has(.preview-media) { width:min(300px,88%); }
  .chat-bubble img,.chat-bubble video { width:100%; display:block;max-width:100%;max-height:160px;border-radius:6px;margin-bottom:8px;object-fit:contain; }
  .chat-bubble small { display:block;margin-top:6px;color:var(--bubble-ink);font-size:var(--fs-2xs);opacity:.72; }
  .chat-bubble code { font-family:var(--font-mono);font-size:.875em; }
  .chat-bubble ul,.chat-bubble ol { margin:0;padding-left:22px;white-space:normal; }
  .chat-bubble li { white-space:pre-wrap; }
  .chat-bubble blockquote { margin:0;padding-left:12px;border-left:1px solid currentColor; }
  .campaign-root #part-count { flex-shrink:0;padding:12px 16px;margin:0;font-size:.75rem; }
  .review-panel { display:flex;flex:1;min-height:min-content; }
  .review-layout { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;flex:1;min-width:0; }
  .review-settings,.review-message { display:flex;flex-direction:column;min-width:0;min-height:0;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--surface); }
  .review-panel-heading { display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px;border-bottom:1px solid var(--line);flex-shrink:0; }
  .campaign-root .review-panel-heading h2 { margin:0;font-size:.9375rem; }
  .campaign-root #review-part-count { font-size:.75rem;white-space:nowrap; }
  .review-settings-body { padding:4px 16px 12px; }
  .review-facts { display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px 20px;margin:0;padding:16px 0;border-bottom:1px solid var(--line);font-size:.875rem; }
  .review-facts dt { color:var(--ink-2); }
  .review-facts dd { margin:0;text-align:right;font-weight:600;font-variant-numeric:tabular-nums; }
  .review-schedule { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:16px 0; }
  .campaign-root .review-schedule h3 { grid-column:1 / -1;margin:0; }
  .review-schedule input { min-width:0; }
  .schedule-control { min-width:0; }
  .campaign-root .schedule-help { margin:6px 0 0;font-size:.75rem;line-height:1.5;font-weight:400; }
  #schedule-field { grid-column:2;grid-row:2; }
  .review-delivery-rules { display:grid;gap:8px;border-top:1px solid var(--line);margin:12px 0 0;padding:12px 0 0 18px;font-size:var(--fs-sm);line-height:1.5; }
  .review-delivery-rules li { padding-left:2px; }
  #sending-estimate { display:block;margin-top:4px; }
  .review-chat { display:flex;flex:1;flex-direction:column;align-items:flex-end;gap:10px;min-height:160px;padding:20px;background:var(--chat);overflow-wrap:anywhere; }
  .review-chat .chat-bubble { width:fit-content;max-width:88%; }
