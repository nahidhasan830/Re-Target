---
import WhatsAppPairing from './WhatsAppPairing.astro';
import TestDestinations from './TestDestinations.astro';
interface Props { phone?: string }
const { phone = '' } = Astro.props;
---
<div class="whatsapp-settings">
  <WhatsAppPairing phone={phone}><slot /></WhatsAppPairing>
  <TestDestinations />
</div>
<style>
  .whatsapp-settings { display:grid;grid-template-columns:1fr;gap:20px;align-content:start;width:100%; }
  .whatsapp-settings :global(.pairing) { display:flex;flex-direction:column;min-width:0; }
  .whatsapp-settings :global(.test-destinations) { align-self:start; }
  .whatsapp-settings :global(.pairing-header),.whatsapp-settings :global(.destinations-header) { min-height:88px; }
  .whatsapp-settings :global(.pairing-body) { grid-template-columns:1fr;flex:1; }
  .whatsapp-settings :global(.pairing-display) { min-height:260px;border-right:0;border-bottom:1px solid var(--line); }
  .whatsapp-settings :global(.pairing-body[data-connected="true"] .pairing-display) { min-height:220px; }
  .whatsapp-settings :global(.connection-actions) { padding:18px 24px; }
  @media(min-width:1100px) { .whatsapp-settings { grid-template-columns:repeat(2,minmax(0,1fr));align-items:start; }.whatsapp-settings :global(.pairing:not(:has(.pairing-body[data-connected="true"]))) { min-height:var(--content-h); } }
  @media(max-width:760px) {
    .whatsapp-settings { gap:16px; }
    .whatsapp-settings :global(.pairing-header) { min-height:auto;flex-direction:row;padding:16px; }
    .whatsapp-settings :global(.destinations-header) { min-height:auto; }
    .whatsapp-settings :global(.pairing-body[data-connected="true"]) { display:none; }
    .whatsapp-settings :global(.connection-actions) { padding:16px; }
    .whatsapp-settings :global(.pairing-empty) { gap:12px; }
    .whatsapp-settings :global(.pairing-empty svg) { width:40px;height:40px; }
  }
</style>
