---
import RefreshIcon from './RefreshIcon.astro';
import LoadingRegion from './LoadingRegion.astro';
import DataTable from './DataTable.astro';
interface Props { courierUrl: string }
const { courierUrl } = Astro.props;
---
<section class="leads-root" data-courier-url={courierUrl}>
  <p id="sync-progress" class="sync-progress" role="status" hidden></p>
  <div class="leads-panel">
    <form id="lead-filters" class="table-tools" role="search" aria-label="Search and filter leads">
      <div class="search-controls"><div class="selection-controls" id="selection-controls"><span class="sr-only" id="selection-count" aria-live="polite"></span><button type="button" class="icon-button toolbar-icon" id="exclude-selected" aria-label="Do not contact" title="Do not contact" disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="m6 6 12 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button><button type="button" class="icon-button toolbar-icon" id="allow-selected" aria-label="Allow contact" title="Allow contact" disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="m8 12 3 3 5-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div><button type="button" class="icon-button toolbar-icon" id="refresh-leads" aria-label="Refresh leads" title="Refresh leads"><RefreshIcon /></button><label class="search-field"><span class="sr-only">Search name or phone</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg><input name="search" type="search" placeholder="Search name or phone" maxlength="120" autocomplete="off" /></label></div>
      <label><span class="sr-only">Courier source</span><select name="source" aria-label="Courier source"><option value="all">All couriers</option><option value="pathao">Pathao</option><option value="steadfast">Steadfast</option></select></label>
      <label><span class="sr-only">Contact preference</span><select name="eligibility" aria-label="Contact preference"><option value="all">All preferences</option><option value="eligible">Contact allowed</option><option value="excluded">Do not contact</option></select></label>
      <label><span class="sr-only">Contact</span><select name="whatsapp" aria-label="Contact"><option value="all">Contact: All</option><option value="yes">WhatsApp</option><option value="imo" disabled>IMO</option><option value="no">None</option></select></label>
      <button type="button" class="secondary" id="date-toggle" popovertarget="date-filters">Delivery date</button>

      <button type="button" class="secondary" id="create-campaign-toggle" popovertarget="create-campaign-options">Create campaign</button>
      <div id="create-campaign-options" class="lead-popover" popover><button class="secondary" id="campaign-from-selected" type="button" disabled>Selected leads</button><button class="secondary" id="campaign-from-matching" type="button">All matching leads</button></div>
      <div class="view-controls" aria-label="Table options">
        <button type="button" class="icon-button toolbar-icon" id="clear-filters" aria-label="Reset filters" title="Reset filters" hidden><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m3 3 18 18M10 4h10l-7 8v7l-3 2v-8M4 4v1l4 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="icon-button toolbar-icon columns-button" popovertarget="lead-columns" aria-label="Columns" title="Columns"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M9 4v16M15 4v16" stroke="currentColor" stroke-width="1.7"/></svg></button>
      </div>
      <div id="date-filters" class="lead-popover" popover>
        <h2>Latest delivery</h2>
        <label>Date availability<select name="dates"><option value="all">All dates</option><option value="known">Known dates</option><option value="unknown">Unknown dates</option></select></label>
        <label>From<input type="date" name="from" /></label><label>Through<input type="date" name="to" /></label>
        <button class="secondary" type="submit">Apply dates</button>
      </div>
    </form>

    <div id="lead-message" class="lead-message" role="status" hidden></div>
    <DataTable id="leads-table" label="Leads table">
    <div slot="empty" id="lead-empty" class="lead-empty" hidden><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 3H4v18h16V3h-4M8 3v4h8V3H8ZM8 12h8M8 16h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><h2 id="empty-title">No leads yet</h2><p id="empty-copy"></p><a id="empty-setup" href={courierUrl}>Set up a courier</a></div>
    </DataTable>
  </div>
  <div id="lead-columns" class="lead-popover" popover><h2>Visible columns</h2><div id="column-options"></div></div>
  <noscript><p>Enable JavaScript to search and manage leads.</p></noscript>
  <dialog id="lead-detail" aria-labelledby="detail-name">
    <header><div><h2 id="detail-name">Contact details</h2><p id="detail-phone"></p></div><button id="close-detail" class="icon-button" aria-label="Close contact details" autofocus><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button></header>
    <p id="detail-location"></p><p id="detail-whatsapp"></p><dl class="parcel-values"><div><dt>Total Value (BDT)</dt><dd id="detail-total-value"></dd></div><div><dt>Average Value (BDT)</dt><dd id="detail-average-value"></dd></div></dl><label class="exclusion-toggle"><input type="checkbox" id="detail-excluded" disabled />Do not contact</label>
    <h3>Campaign history</h3><ul id="lead-campaign-history"></ul><p id="lead-last-contact"></p>
    <p id="detail-message" role="status"></p><h3>Shipment history</h3><LoadingRegion id="shipment-history-loading" variant="history" label="Loading shipment history…" pending={false}><ul id="shipment-history"></ul></LoadingRegion><button class="secondary" id="more-history" hidden>Load more shipments</button>
  </dialog>
</section>
<script>
  import '../lib/leads-table';
</script>
<style is:global>
  main:has(.leads-root) { padding: 12px 16px 16px; }
  .leads-root { min-width: 0; }
  .leads-root [hidden] { display: none !important; }
  html.lead-detail-open { overflow: hidden; }
  .leads-root svg { width: 20px; height: 20px; flex-shrink: 0; }
  .sync-progress { margin: 0 0 16px; padding: 12px 16px; border-radius: 8px; background: var(--green-soft); color: var(--green); font-size: .875rem; overflow-wrap: anywhere; }
  .sync-progress[data-error=true] { background: #f7e7e2; color: var(--error); }
  .leads-panel { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; position: relative; }
  .table-tools { display: flex; gap: 10px; padding: 12px; align-items: center; flex-wrap: wrap; }
  .leads-root input, .leads-root select { color: var(--ink); background: var(--surface); font: inherit; accent-color: var(--green); caret-color: var(--green); }
  .leads-root select, .leads-root input[type=date] { border: 1px solid var(--line); border-radius: 8px; padding: 9px 10px; min-height: 44px; font-size: .8125rem; }
  .search-controls { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 320px; }
  .search-field { flex: 1; min-width: 0; display: flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; padding-left: 12px; gap: 8px; color: var(--muted); }
  .search-field input { border: 0; background: transparent; width: 100%; min-width: 0; padding: 10px 12px 10px 0; min-height: 44px; font-size: .875rem; outline: none; }
  .search-field:focus-within { outline: 2px solid var(--green); outline-offset: 2px; }
  .leads-root input::placeholder { color: var(--muted); opacity: 1; }
  .selection-controls { display: flex; gap: 4px; align-items: center; flex-shrink: 0; }
  .view-controls { display: flex; align-items: center; gap: 4px; }
  .leads-root .toolbar-icon { border: 1px solid var(--line); color: var(--muted); }
  .leads-root .toolbar-icon:not(:disabled):hover { color: var(--green); background: var(--green-soft); }
  .selection-controls > span { color: var(--muted); }
  .leads-root .text-button { border: 0; color: var(--green); background: transparent; padding: 8px 4px; min-height: 44px; cursor: pointer; font-size: .8125rem; font-weight: 550; }
  .leads-root button:disabled { cursor: not-allowed; opacity: .55; }
  .leads-root .secondary { font-size: .8125rem; padding: 9px 12px; }
  .lead-message { padding: 12px 16px; background: var(--green-soft); font-size: .875rem; }
  .lead-message[data-error=true] { color: var(--error); background: #f7e7e2; }
  .lead-message.success-feedback { padding:0;background:transparent; }
  .lead-empty { padding: 44px 20px; text-align: center; min-height: 260px; }
  .lead-empty > svg { width: 36px; height: 36px; color: var(--muted); }
  .leads-root h2 { font-size: 1.125rem; font-weight: 650; letter-spacing: -.02em; margin: 12px 0 8px; }
  .lead-empty p { max-width: 48ch; margin: 0 auto 16px; color: var(--muted); font-size: .875rem; }
  .lead-empty a { display: inline-flex; align-items: center; min-height: 44px; }
  .leads-root .lead-popover { position: fixed; inset: auto; margin: 0; width: 280px; max-width: calc(100vw - 24px); max-height: calc(100dvh - 24px); overflow-y: auto; padding: 20px; border: 1px solid var(--line); border-radius: 16px; color: var(--ink); background: var(--surface); box-shadow: 0 12px 32px rgb(32 42 38 / 12%); }
  .lead-popover h2 { margin-top: 0; }
  .lead-popover label { display: flex; flex-direction: column; gap: 6px; margin: 12px 0; font-size: .875rem; }
  #column-options label { flex-direction: row; align-items: center; min-height: 44px; margin: 0; gap: 12px; }
  .leads-root input[type=checkbox] { width: 18px; height: 18px; flex-shrink: 0; }
  .leads-root .tabulator .tabulator-row .tabulator-cell[tabulator-field="_select"] { padding: 0; justify-content: center; }
  .leads-root .tabulator .tabulator-header .tabulator-col[tabulator-field="_select"] .tabulator-col-content { padding: 0; }
  .lead-select-target { display: inline-flex; align-items: center; justify-content: center; width: 44px; min-height: 48px; cursor: pointer; }
  .lead-identity { display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
  .lead-identity strong { font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
  .leads-root .eligibility { display: inline-block; padding: 3px 8px; border-radius: 6px; background: var(--green-soft); color: var(--green); font-size: .75rem; }
  .leads-root .eligibility.excluded { background: var(--paper); color: var(--muted); }
  .leads-root .detail-button { border: 0; border-radius: 8px; background: transparent; color: var(--green); min-height: 44px; min-width: 44px; cursor: pointer; padding: 8px; }
  #lead-detail { inset: 0 0 0 auto; width: min(480px, 100vw); max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 24px; border: 0; border-left: 1px solid var(--line); background: var(--surface); color: var(--ink); overflow-y: auto; scrollbar-color: var(--line) var(--surface); }
  #lead-detail::backdrop { background: rgb(32 42 38 / 40%); }
  #lead-detail header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  #lead-detail h2 { margin-top: 0; overflow-wrap: anywhere; }
  #detail-phone, #detail-location { color: var(--muted); font-size: .875rem; margin: 4px 0 16px; overflow-wrap: anywhere; }
  .exclusion-toggle { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 12px 0; border-block: 1px solid var(--line); font-size: .875rem; }
  #detail-message { font-size: .8125rem; color: var(--muted); }
  #lead-detail h3 { font-size: .9375rem; margin: 24px 0 8px; }
  #shipment-history { list-style: none; margin: 0 0 16px; padding: 0; }
  #shipment-history li { border-bottom: 1px solid var(--line); padding: 12px 0; font-size: .8125rem; overflow-wrap: anywhere; }
  #shipment-history strong, #shipment-history span { display: block; }
  #shipment-history span { color: var(--muted); margin-top: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .whatsapp-account { display: inline-flex; align-items: center; gap: 6px; color: var(--green); }
  .whatsapp-account svg { width: 20px; height: 20px; }
  .whatsapp-unchecked { color: var(--muted); }
  .parcel-values { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: .8125rem; }
  .parcel-values dt { color: var(--muted); }
  .parcel-values dd { margin: 4px 0 0; font-size: 1rem; font-variant-numeric: tabular-nums; }
  #detail-whatsapp { font-size: .8125rem; color: var(--muted); }
  @media (max-width: 760px) {
    main:has(.leads-root) { padding: 12px; }
    .table-tools { padding: 12px; gap: 8px; }
    .search-controls { width: 100%; flex-basis: 100%; min-width: 0; }
    .table-tools > label:not(.search-field) { flex: 1 1 calc(50% - 4px); min-width: 0; }
    .table-tools #date-toggle { margin-right: auto; }
    .table-tools select { width: 100%; }
    .view-controls { margin-left: auto; }
    .columns-button { display: none; }
    .table-tools > label:has([name=eligibility]) { display: none; }
    .lead-empty { padding: 30px 16px; }
    #lead-detail { padding: 20px; }
  }
</style>
<style is:global>
  #lead-campaign-history { list-style:none;padding:0;font-size:.875rem; }
  #lead-campaign-history li { padding:8px 0;border-bottom:1px solid var(--line); }
</style>
