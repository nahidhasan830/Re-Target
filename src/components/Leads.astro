---
import RefreshIcon from './RefreshIcon.astro';
import LoadingRegion from './LoadingRegion.astro';
import DataTable from './DataTable.astro';
import Icon from './Icon.astro';
interface Props { courierUrl: string }
const { courierUrl } = Astro.props;
---
<section class="leads-root" data-courier-url={courierUrl}>
  <p id="sync-progress" class="sync-progress" role="status" hidden></p>
  <div class="leads-panel">
    <form id="lead-filters" class="table-tools" role="search" aria-label="Search and filter leads">
      <div class="search-controls"><div class="selection-controls" id="selection-controls"><span class="sr-only" id="selection-count" aria-live="polite"></span><button type="button" class="icon-button toolbar-icon" id="exclude-selected" aria-label="Do not contact" title="Do not contact" disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="m6 6 12 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button><button type="button" class="icon-button toolbar-icon" id="allow-selected" aria-label="Allow contact" title="Allow contact" disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="m8 12 3 3 5-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div><button type="button" class="icon-button toolbar-icon" id="refresh-leads" aria-label="Refresh leads" title="Refresh leads"><RefreshIcon /></button><label class="search-field"><span class="sr-only">Search name or phone</span><Icon name="search" /><input name="search" type="search" placeholder="Search name or phone" maxlength="120" autocomplete="off" /></label></div>
      <label><span class="sr-only">Courier source</span><select name="source" aria-label="Courier source"><option value="all">All couriers</option><option value="pathao">Pathao</option><option value="steadfast">Steadfast</option></select></label>
      <label><span class="sr-only">Contact preference</span><select name="eligibility" aria-label="Contact preference"><option value="all">All preferences</option><option value="eligible">Contact allowed</option><option value="excluded">Do not contact</option></select></label>
      <label><span class="sr-only">Contact</span><select name="whatsapp" aria-label="Contact"><option value="all">Contact: All</option><option value="yes">WhatsApp</option><option value="imo" disabled>IMO</option><option value="no">None</option></select></label>
      <button type="button" class="secondary" id="date-toggle" popovertarget="date-filters">Delivery date</button>

      <button type="button" class="secondary" id="create-campaign-toggle" popovertarget="create-campaign-options">Create campaign</button>
      <div id="create-campaign-options" class="lead-popover" popover><button class="secondary" id="campaign-from-selected" type="button" disabled>Selected leads</button><button class="secondary" id="campaign-from-matching" type="button">All matching leads</button></div>
      <div class="view-controls" aria-label="Table options">
        <button type="button" class="icon-button toolbar-icon" id="clear-filters" aria-label="Reset filters" title="Reset filters" hidden><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m3 3 18 18M10 4h10l-7 8v7l-3 2v-8M4 4v1l4 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="icon-button toolbar-icon columns-button" popovertarget="lead-columns" aria-label="Columns" title="Columns"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M9 4v16M15 4v16" stroke="currentColor" stroke-width="1.7"/></svg></button>
      </div>
      <div id="date-filters" class="lead-popover" popover>
        <h2>Latest delivery</h2>
        <label>Date availability<select name="dates"><option value="all">All dates</option><option value="known">Known dates</option><option value="unknown">Unknown dates</option></select></label>
        <label>From<input type="date" name="from" /></label><label>Through<input type="date" name="to" /></label>
        <button class="secondary" type="submit">Apply dates</button>
      </div>
    </form>

    <div id="lead-message" class="lead-message" role="status" hidden></div>
    <DataTable id="leads-table" label="Leads table">
    <div slot="empty" id="lead-empty" class="lead-empty empty-state" hidden><span class="empty-mark" aria-hidden="true"><Icon name="leads" /></span><h2 id="empty-title">No leads yet</h2><p id="empty-copy"></p><a id="empty-setup" href={courierUrl}>Set up a courier</a></div>
    </DataTable>
  </div>
  <div id="lead-columns" class="lead-popover" popover><h2>Visible columns</h2><div id="column-options"></div></div>
  <noscript><p>Enable JavaScript to search and manage leads.</p></noscript>
  <dialog id="lead-detail" aria-labelledby="detail-name">
    <header><div><h2 id="detail-name">Contact details</h2><p id="detail-phone"></p></div><button id="close-detail" class="icon-button" aria-label="Close contact details" autofocus><Icon name="close" /></button></header>
    <p id="detail-location"></p><p id="detail-whatsapp"></p><dl class="parcel-values"><div><dt>Total Value (BDT)</dt><dd id="detail-total-value"></dd></div><div><dt>Average Value (BDT)</dt><dd id="detail-average-value"></dd></div></dl><label class="exclusion-toggle"><input type="checkbox" id="detail-excluded" disabled />Do not contact</label>
    <h3>Campaign history</h3><ul id="lead-campaign-history"></ul><p id="lead-last-contact"></p>
    <p id="detail-message" role="status"></p><h3>Shipment history</h3><LoadingRegion id="shipment-history-loading" variant="history" label="Loading shipment history…" pending={false}><ul id="shipment-history"></ul></LoadingRegion><button class="secondary" id="more-history" hidden>Load more shipments</button>
  </dialog>
</section>
<script>
  import '../lib/leads-table';
</script>
<style is:global>
  main:has(.leads-root) { padding: 12px 16px calc(16px + var(--nav-h)); }
  .leads-root { min-width: 0; }
  html.lead-detail-open { overflow: hidden; }
  .leads-root svg { width: 20px; height: 20px; flex-shrink: 0; }
  .sync-progress { margin: 0 0 12px; padding: 10px 14px; border-radius: var(--r-md); background: var(--current-soft); color: var(--current); font-size: var(--fs-sm); overflow-wrap: anywhere; }
  .sync-progress[data-error=true] { background: var(--danger-soft); color: var(--danger); }
  .leads-panel { position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); }
  .table-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px; border-bottom: 1px solid var(--line); }
  .leads-root select, .leads-root input[type=date] { width: auto; font-size: var(--fs-sm); }
  .search-controls { display: flex; flex: 1; align-items: center; gap: 6px; min-width: 320px; }
  .search-field { display: flex; flex: 1; align-items: center; gap: 8px; min-width: 0; padding-left: 12px; border: 1px solid var(--line-strong); border-radius: var(--r-md); background: var(--surface); color: var(--ink-3); transition: border-color var(--dur-1) var(--ease-out), box-shadow var(--dur-1) var(--ease-out); }
  .search-field:hover { border-color: var(--ink-3); }
  .leads-root .search-field input { min-height: 42px; padding: 0 12px 0 0; border: 0; background: transparent; box-shadow: none; font-size: var(--fs-btn); }
  .search-field:focus-within { border-color: var(--focus); box-shadow: 0 0 0 3px var(--current-ring); }
  .selection-controls { display: flex; flex-shrink: 0; align-items: center; gap: 4px; }
  .view-controls { display: flex; align-items: center; gap: 4px; }
  .leads-root .toolbar-icon { border: 1px solid var(--line-strong); }
  .leads-root .toolbar-icon:not(:disabled):hover { border-color: var(--ink-3); }
  .leads-root .text-button { min-height: 44px; padding: 8px 4px; border: 0; background: transparent; color: var(--accent-fg); font-size: var(--fs-sm); font-weight: 600; cursor: pointer; }
  .leads-root .secondary { font-size: var(--fs-sm); padding-inline: 12px; }
  .lead-message { padding: 10px 14px; border-bottom: 1px solid var(--line); background: var(--success-soft); color: var(--success); font-size: var(--fs-sm); }
  .lead-message[data-error=true] { background: var(--danger-soft); color: var(--danger); }
  .lead-message.success-feedback { display: flex; background: transparent; }
  .lead-empty { min-height: 260px; padding: 40px 20px; }
  .lead-empty a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .leads-root .lead-popover { position: fixed; inset: auto; width: 280px; max-width: calc(100vw - 24px); max-height: calc(100dvh - 24px); margin: 0; padding: 16px; overflow-y: auto; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); color: var(--ink); box-shadow: var(--shadow-overlay); }
  .lead-popover h2 { margin-bottom: 4px; font-size: var(--fs-md); }
  .lead-popover label { display: flex; flex-direction: column; gap: 6px; margin: 12px 0; }
  #create-campaign-options { display: none; }
  #create-campaign-options:popover-open { display: grid; gap: 8px; width: 220px; padding: 8px; }
  #column-options label { flex-direction: row; align-items: center; gap: 12px; min-height: 40px; margin: 0; font-weight: 500; }
  .leads-root .tabulator .tabulator-row .tabulator-cell[tabulator-field="_select"] { justify-content: center; padding: 0; }
  .leads-root .tabulator .tabulator-header .tabulator-col[tabulator-field="_select"] .tabulator-col-content { padding: 0; }
  .lead-select-target { display: inline-flex; align-items: center; justify-content: center; width: 44px; min-height: 48px; cursor: pointer; }
  .lead-identity { display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
  .lead-identity strong { overflow: hidden; font-weight: 600; text-overflow: ellipsis; }
  .leads-root .eligibility { display: inline-flex; align-items: center; gap: 7px; min-height: 22px; padding: 1px 8px 1px 7px; border-radius: var(--r-sm); background: var(--success-soft); color: var(--success); font-size: var(--fs-xs); font-weight: 600; white-space: nowrap; }
  .leads-root .eligibility::before { content: ''; width: 6px; height: 6px; border-radius: 1px; background: currentColor; transform: rotate(45deg); }
  .leads-root .eligibility.excluded { background: var(--surface-3); color: var(--ink-2); }
  .leads-root .detail-button { min-width: 44px; min-height: 44px; padding: 8px; border: 0; border-radius: var(--r-md); background: transparent; color: var(--accent-fg); cursor: pointer; }
  .leads-root .detail-button:hover { background: var(--accent-soft); }
  #lead-detail { inset: 0 0 0 auto; width: min(480px, 100vw); max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 20px 24px 24px; overflow-y: auto; border-radius: var(--r-xl) 0 0 var(--r-xl); }
  #lead-detail[open] { animation: drawer-in var(--dur-3) var(--ease-out); }
  @keyframes drawer-in { from { transform: translateX(100%); } }
  #lead-detail header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  #lead-detail h2 { margin-top: 6px; font-size: var(--fs-xl); overflow-wrap: anywhere; }
  #detail-phone, #detail-location { margin: 4px 0 14px; color: var(--ink-2); font-size: var(--fs-sm); overflow-wrap: anywhere; }
  .exclusion-toggle { display: flex; align-items: center; gap: 12px; min-height: 52px; margin-top: 16px; padding: 12px 0; border-block: 1px solid var(--line); font-size: var(--fs-md); font-weight: 500; }
  #detail-message { color: var(--ink-2); font-size: var(--fs-sm); }
  #lead-detail h3 { margin: 22px 0 6px; font-size: var(--fs-md); }
  #shipment-history { margin: 0 0 16px; padding: 0; list-style: none; }
  #shipment-history li { padding: 10px 0; border-bottom: 1px solid var(--line); font-size: var(--fs-sm); overflow-wrap: anywhere; }
  #shipment-history strong, #shipment-history span { display: block; }
  #shipment-history span { margin-top: 2px; color: var(--ink-2); }
  .whatsapp-account { display: inline-flex; align-items: center; gap: 6px; color: var(--success); font-weight: 560; }
  .whatsapp-account svg { width: 18px; height: 18px; }
  .whatsapp-unchecked { color: var(--ink-3); }
  .parcel-values { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 16px 0 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--line); font-size: var(--fs-sm); }
  .parcel-values > div { padding: 10px 12px; background: var(--surface-2); }
  .parcel-values dt { color: var(--ink-2); font-size: var(--fs-xs); }
  .parcel-values dd { margin: 2px 0 0; font-size: var(--fs-lg); font-weight: 620; }
  #detail-whatsapp { color: var(--ink-2); font-size: var(--fs-sm); }
  #lead-campaign-history { padding: 0; list-style: none; font-size: var(--fs-sm); }
  #lead-campaign-history li { padding: 8px 0; border-bottom: 1px solid var(--line); }
  @media (max-width: 760px) {
    main:has(.leads-root) { padding: 12px 12px calc(12px + var(--nav-h)); }
    .table-tools { gap: 8px; }
    .search-controls { flex-basis: 100%; width: 100%; min-width: 0; }
    .table-tools > label:not(.search-field) { flex: 1 1 calc(50% - 4px); min-width: 0; }
    .table-tools #date-toggle, .table-tools #create-campaign-toggle { flex: 1 1 calc(50% - 4px); min-width: 0; }
    .view-controls:not(:has(#clear-filters:not([hidden]))) { display: none; }
    .table-tools select { width: 100%; }
    .view-controls { margin-left: auto; }
    .columns-button { display: none; }
    .table-tools > label:has([name=eligibility]) { display: none; }
    .lead-empty { padding: 28px 16px; }
    #lead-detail { width: 100vw; padding: 16px 16px 24px; border-radius: 0; }
  }
</style>
