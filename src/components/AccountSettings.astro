---
import type { Account } from '../lib/auth';
import type { AccountSettingsState } from '../lib/account-settings';
import SuccessFeedback from './SuccessFeedback.astro';
interface Props { account: Account; state: AccountSettingsState; saved: string | null }
const { account, state, saved } = Astro.props;
const action = account.role === 'admin' ? '/admin/account' : '/app/account';
const passwords = [
  { name: 'currentPassword', label: 'Current password', autocomplete: 'current-password', minimum: 1 },
  { name: 'newPassword', label: 'New password', autocomplete: 'new-password', minimum: 10 },
  { name: 'confirmPassword', label: 'Confirm new password', autocomplete: 'new-password', minimum: 10 },
] as const;
---
<div class="account-settings">
  <section class="settings-panel company-panel" aria-labelledby="company-title">
    <h2 id="company-title">Company details</h2>
    <form method="post" action={action} data-account-form="company">
      <input type="hidden" name="action" value="company" />
      <div class="field"><label for="companyName">Company name</label><input id="companyName" name="companyName" autocomplete="organization" value={state.companyName} required maxlength="120" aria-invalid={state.errors.companyName ? 'true' : undefined} aria-describedby="companyName-error" /><p id="companyName-error" class="field-error" hidden={!state.errors.companyName}>{state.errors.companyName}</p></div>
      <p class="form-message" role="alert" hidden={!state.message || state.form === 'password'}>{state.form !== 'password' && state.message}</p>
      <div class="form-footer"><button class="primary" type="submit" data-idle="Save company name" data-pending="Saving…">Save company name</button><p class="save-status" role="status" aria-atomic="true"><SuccessFeedback label="Saved" message={saved === 'company' ? 'Company name updated.' : ''} /></p></div>
    </form>
  </section>
  <details class="settings-panel password-panel" open>
    <summary><h2>Password</h2><span class="password-action"><span class="change-label">Change password</span><span class="back-label">Company details</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span></summary>
    <form method="post" action={action} data-account-form="password">
      <input type="hidden" name="action" value="password" />
      <input class="sr-only" type="text" value={account.phone} autocomplete="username" tabindex="-1" aria-hidden="true" readonly />
      {passwords.map((field) => <div class="field">
        <label for={field.name}>{field.label}</label>
        <div class="password-wrap"><input id={field.name} name={field.name} type="password" autocomplete={field.autocomplete} required minlength={field.minimum} maxlength="128" aria-invalid={state.errors[field.name] ? 'true' : undefined} aria-describedby={`${field.name}-error${field.name === 'newPassword' ? ' password-hint' : ''}`} /><button class="password-toggle" type="button" aria-label={`Show ${field.label.toLowerCase()}`} aria-controls={field.name} aria-pressed="false" hidden>
          <svg class="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18M10.6 5.1 12 5c6.5 0 10 7 10 7a19 19 0 0 1-3.1 3.9M6.1 6.1A22 22 0 0 0 2 12s3.5 7 10 7a12 12 0 0 0 5.9-1.9M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
        </button></div>
        <p id={`${field.name}-error`} class="field-error" hidden={!state.errors[field.name]}>{state.errors[field.name]}</p>
        {field.name === 'newPassword' && <p id="password-hint" class="field-hint">At least 10 characters.</p>}
      </div>)}
      <p class="form-message" role="alert" hidden={!state.message || state.form !== 'password'}>{state.form === 'password' && state.message}</p>
      <div class="form-footer"><button class="primary" type="submit" data-idle="Update password" data-pending="Updating…">Update password</button><p class="save-status" role="status" aria-atomic="true"><SuccessFeedback label="Updated" message={saved === 'password' ? 'Password updated.' : ''} detail="Other sessions signed out." /></p></div>
    </form>
  </details>
</div>
<script>
  import { validateAccountUpdate, type AccountErrors } from '../lib/account-validation';
  import { setFeedback } from '../lib/feedback';
  const passwordPanel = document.querySelector<HTMLDetailsElement>('.password-panel')!;
  const compact = window.matchMedia('(max-width: 760px)');
  if (compact.matches && !passwordPanel.querySelector('[aria-invalid="true"], .form-message:not([hidden])') && !passwordPanel.querySelector('.save-status')?.textContent) passwordPanel.open = false;
  compact.addEventListener('change', () => { if (!compact.matches) passwordPanel.open = true; });
  document.querySelectorAll<HTMLButtonElement>('.password-toggle').forEach((toggle) => {
    const input = document.getElementById(toggle.getAttribute('aria-controls')!) as HTMLInputElement;
    const label = toggle.getAttribute('aria-label')!.slice(5);
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const visible = input.type === 'password'; input.type = visible ? 'text' : 'password';
      toggle.setAttribute('aria-label', `${visible ? 'Hide' : 'Show'} ${label}`); toggle.setAttribute('aria-pressed', String(visible));
    });
  });
  document.querySelectorAll<HTMLFormElement>('[data-account-form]').forEach((form) => {
    form.noValidate = true;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('.save-status')!;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[name]:not([type="hidden"])'));
    let busy = false;
    const showErrors = (errors: AccountErrors) => fields.forEach((field) => {
      const error = errors[field.name as keyof AccountErrors]; field.setAttribute('aria-invalid', String(Boolean(error)));
      const message = document.getElementById(`${field.name}-error`)!; message.textContent = error ?? ''; message.hidden = !error;
    });
    const validate = () => validateAccountUpdate({ action: form.dataset.accountForm!, ...Object.fromEntries(fields.map((field) => [field.name, field.value])) });
    fields.forEach((field) => field.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') showErrors(validate().errors);
      form.querySelector<HTMLElement>('.form-message')!.hidden = true; if (!busy) setFeedback(status, '');
    }));
    form.addEventListener('submit', (event) => {
      if (busy) { event.preventDefault(); return; }
      const { result, errors } = validate(); showErrors(errors);
      if (!result.success) { event.preventDefault(); fields.find((field) => errors[field.name as keyof AccountErrors])?.focus(); return; }
      busy = true; button.disabled = true; button.textContent = button.dataset.pending!;
      setFeedback(status, form.dataset.accountForm === 'password' ? 'Updating...' : 'Saving...'); form.setAttribute('aria-busy', 'true');
    });
    window.addEventListener('pageshow', () => { if (busy) setFeedback(status, ''); busy = false; button.disabled = false; button.textContent = button.dataset.idle!; form.removeAttribute('aria-busy'); });
  });
  document.querySelector<HTMLInputElement>('[aria-invalid="true"]')?.focus();
</script>
<style>
  .account-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 24px; }
  .account-heading .intro { margin: 0; }
  .account-identity { display: flex; align-items: center; gap: 12px; padding-top: 8px; }
  .account-phone { font-size: .875rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .account-settings { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 24px; }
  .settings-panel { min-width: 0; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  h2 { margin: 0; font-size: 1.125rem; font-weight: 650; line-height: 1.4; letter-spacing: -.02em; }
  form { margin-top: 20px; }
  .field + .field { margin-top: 16px; }
  label { display: block; margin-bottom: 6px; font-size: .875rem; font-weight: 600; }
  input:not([type="hidden"]) { width: 100%; height: 48px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); padding: 10px 14px; font-size: 1rem; caret-color: var(--green); }
  input:hover:not(:disabled) { border-color: var(--muted); }
  input[aria-invalid="true"] { border-color: var(--error); }
  .field-error, .field-hint { margin: 6px 0 0; font-size: .8125rem; line-height: 1.4; }
  .field-error { color: var(--error); } .field-hint { color: var(--muted); }
  .password-wrap { position: relative; } .password-wrap input { padding-right: 56px; }
  .password-toggle { position: absolute; top: 2px; right: 2px; width: 44px; height: 44px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; }
  .password-toggle:hover:not(:disabled) { background: var(--green-soft); color: var(--ink); } .password-toggle:active:not(:disabled) { background: var(--paper); }
  .password-toggle svg { width: 20px; height: 20px; }
  .eye-off, .password-toggle[aria-pressed="true"] .eye { display: none; } .password-toggle[aria-pressed="true"] .eye-off { display: block; }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; list-style: none; min-height: 44px; cursor: pointer; margin: -8px 0; }
  summary::-webkit-details-marker { display: none; }
  .password-action { display: inline-flex; align-items: center; gap: 8px; color: var(--green); font-size: .8125rem; font-weight: 600; }
  .password-action svg { width: 18px; height: 18px; } .back-label, details[open] .password-action span { display: none; } details[open] .password-action svg { transform: rotate(90deg); }
  .form-footer { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 16px; margin-top: 20px; } .form-footer .primary { width: auto; }
  .save-status { margin: 0; color: var(--green); font-size: .8125rem; line-height: 1.4; } .save-status:empty { display: none; }
  .form-message { padding: 10px 14px; background: #f7e7e2; color: var(--error); border-radius: 8px; font-size: .875rem; }
  .sr-only { position: absolute; width: 1px !important; height: 1px !important; padding: 0 !important; border: 0 !important; clip-path: inset(50%); overflow: hidden; }
  [hidden] { display: none !important; }
  @media (max-width: 1000px) { .account-heading { flex-direction: column; gap: 12px; } .account-identity { padding-top: 0; } }
  @media (max-width: 760px) {
    .account-heading { flex-direction: row; align-items: center; margin-bottom: 20px; } .account-heading h1 { margin: 0; } .account-heading .intro { display: none; }
    .account-settings { grid-template-columns: 1fr; gap: 16px; } .settings-panel { padding: 20px; } .form-footer .primary { width: 100%; }
    .form-footer:has(.success-feedback) .primary { width:auto;flex:1; }
    .account-settings:has(.password-panel[open]) .company-panel { display: none; }
    details[open] .password-action .back-label { display: inline; } details[open] .password-action svg { transform: rotate(180deg); }
  }
  @media (max-height: 740px) and (min-width: 761px) { .account-heading { margin-bottom: 20px; } .settings-panel { padding: 20px; } }
</style>
