---
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class:list={['brand-mark', className]} viewBox="0 0 32 32" aria-hidden="true"><rect x="6.1" y="6.1" width="19.8" height="19.8" rx="4" transform="rotate(45 16 16)" fill="currentColor"/><rect x="11.6" y="11.6" width="8.8" height="8.8" rx="1.6" transform="rotate(45 16 16)" fill="none" stroke="var(--on-accent)" stroke-width="2"/><circle cx="16" cy="16" r="1.7" fill="var(--on-accent)"/></svg>
