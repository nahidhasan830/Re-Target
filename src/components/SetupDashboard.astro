---
import RefreshIcon from './RefreshIcon.astro';
import { setupGuide, type SetupProgress } from '../lib/setup-guide';
interface Props { role: 'admin' | 'user'; progress: SetupProgress | null }
const { role, progress } = Astro.props;
const base = role === 'admin' ? '/admin' : '/app';
const guide = progress && setupGuide(progress, base);
const placeholder = setupGuide({ companyName: '', whatsapp: false, courier: false, leads: false, media: false, campaign: false, importing: false }, base);
const steps = guide?.steps ?? placeholder.steps;
---
<section class="setup-dashboard" data-base={base} data-initial={JSON.stringify(progress)} aria-labelledby="setup-title">
  <div class="setup-heading">
    <div><h2 id="setup-title">{guide?.complete ? 'Your business is set up' : 'Get ready to send your first offer'}</h2><p>Follow the steps below. Completed steps tick automatically.</p></div>
    <button class="secondary setup-refresh" type="button" aria-label="Refresh setup progress"><RefreshIcon /><span>Refresh</span></button>
  </div>
  <div class="setup-error" role="alert" hidden={Boolean(progress)}>Couldn’t load your setup progress. Try Refresh.</div>
  <p class="setup-announcement" role="status" aria-live="polite"></p>
  <div class="setup-layout" hidden={!progress}>
    <section class="setup-checklist" aria-labelledby="checklist-title">
      <div class="checklist-header"><div><h3 id="checklist-title">Setup checklist</h3><p id="setup-count">{guide?.completed} of {guide?.total} required steps complete</p></div><progress id="setup-progress" value={guide?.completed ?? 0} max="5" aria-labelledby="setup-count"></progress></div>
      <ol class="setup-steps">
        {steps.map((step, index) => <li data-step={step.id} class:list={{ 'is-complete': step.complete, 'is-next': step.id === guide?.next?.id }}>
          <a href={step.href} aria-current={step.id === guide?.next?.id ? 'step' : undefined}>
            <span class="step-marker" aria-hidden="true"><span class="step-number">{index + 1}</span><svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="step-copy"><span class="step-title">{step.title}{step.optional && <span class="optional-label">Optional</span>}</span><span class="step-description">{step.description}</span></span>
            <span class="step-status">{step.complete ? 'Done' : step.id === guide?.next?.id ? progress?.importing && step.id === 'leads' ? 'Importing' : 'Up next' : step.optional ? '' : 'To do'}</span>
            <svg class="step-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>)}
      </ol>
    </section>
    <section class="setup-next" aria-labelledby="next-title">
      <h3 id="next-title" class="next-task">{guide?.next?.title ?? 'Keep your customers coming back'}</h3>
      <p class="next-description">{guide?.next?.description ?? 'Your first campaign is launched. Open Campaigns to follow its progress or create another offer.'}</p>
      <a class="primary next-action" href={guide?.next?.href ?? `${base}/campaigns`}>{guide?.next?.action ?? 'Open Campaigns'}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <p class="next-note">{guide?.complete ? 'You can revisit any step to update your settings.' : 'You can return to this dashboard at any time to continue.'}</p>
    </section>
  </div>
</section>
<script>
  import { setupGuide, type SetupProgress } from '../lib/setup-guide';
  import { setButtonBusy } from '../lib/control-state';
  const root = document.querySelector<HTMLElement>('.setup-dashboard')!;
  const base = root.dataset.base as '/admin' | '/app';
  const refresh = root.querySelector<HTMLButtonElement>('.setup-refresh')!;
  const error = root.querySelector<HTMLElement>('.setup-error')!;
  const announcement = root.querySelector<HTMLElement>('.setup-announcement')!;
  let previous = root.dataset.initial!;
  let busy = false;
  let active = true;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let controller: AbortController | undefined;
  const setText = (selector: string, value: string) => { root.querySelector<HTMLElement>(selector)!.textContent = value; };
  function render(progress: SetupProgress) {
    const guide = setupGuide(progress, base);
    root.querySelector<HTMLElement>('.setup-layout')!.hidden = false;
    setText('#setup-title', guide.complete ? 'Your business is set up' : 'Get ready to send your first offer');
    setText('#setup-count', `${guide.completed} of ${guide.total} required steps complete`);
    root.querySelector<HTMLProgressElement>('#setup-progress')!.value = guide.completed;
    for (const step of guide.steps) {
      const row = root.querySelector<HTMLElement>(`[data-step="${step.id}"]`)!;
      const next = guide.next?.id === step.id;
      row.classList.toggle('is-complete', step.complete);
      row.classList.toggle('is-next', next);
      const link = row.querySelector('a')!;
      if (next) link.setAttribute('aria-current', 'step'); else link.removeAttribute('aria-current');
      row.querySelector('.step-description')!.textContent = step.description;
      row.querySelector('.step-status')!.textContent = step.complete ? 'Done' : next ? progress.importing && step.id === 'leads' ? 'Importing' : 'Up next' : step.optional ? '' : 'To do';
    }
    setText('#next-title', guide.next?.title ?? 'Keep your customers coming back');
    setText('.next-description', guide.next?.description ?? 'Your first campaign is launched. Open Campaigns to follow its progress or create another offer.');
    const link = root.querySelector<HTMLAnchorElement>('.next-action')!;
    link.href = guide.next?.href ?? `${base}/campaigns`;
    link.firstChild!.textContent = guide.next?.action ?? 'Open Campaigns';
    setText('.next-note', guide.complete ? 'You can revisit any step to update your settings.' : 'You can return to this dashboard at any time to continue.');
    return guide;
  }
  function schedule() {
    clearTimeout(timer);
    if (active && !document.hidden) timer = setTimeout(() => void update(), 30000);
  }
  async function update(manual = false) {
    if (busy || !active) return;
    clearTimeout(timer);
    busy = true;
    controller = new AbortController();
    const timeout = setTimeout(() => controller?.abort(), 10000);
    if (manual) { setButtonBusy(refresh, true, false, 'Refreshing...'); root.setAttribute('aria-busy', 'true'); }
    try {
      const response = await fetch('/api/setup-progress', { cache: 'no-store', signal: controller.signal });
      if (response.status === 401) throw new Error('Your session has expired. Log in again to check your progress.');
      if (!response.ok) throw new Error('Couldn’t refresh your setup progress. Try Refresh.');
      const progress: SetupProgress = await response.json();
      const guide = render(progress);
      error.hidden = true;
      const current = JSON.stringify(progress);
      if (manual || current !== previous) announcement.textContent = guide.complete ? 'All required setup steps are complete.' : `${guide.completed} of ${guide.total} required steps complete. Next: ${guide.next!.title}.`;
      previous = current;
    } catch (cause) {
      if (!active) return;
      error.textContent = cause instanceof Error && cause.name !== 'AbortError' ? cause.message : 'Couldn’t refresh your setup progress. Try Refresh.';
      error.hidden = false;
    } finally {
      clearTimeout(timeout);
      busy = false;
      setButtonBusy(refresh, false);
      root.removeAttribute('aria-busy');
      schedule();
    }
  }
  refresh.addEventListener('click', () => void update(true));
  document.addEventListener('visibilitychange', () => { clearTimeout(timer); if (!document.hidden) void update(); });
  window.addEventListener('pagehide', () => { active = false; clearTimeout(timer); controller?.abort(); });
  window.addEventListener('pageshow', event => { active = true; if (event.persisted) void update(); else schedule(); });
  schedule();
</script>
<style>
  .setup-heading { display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px; }
  h2 { margin:0 0 6px;font-size:1.625rem;font-weight:650;line-height:1.3;letter-spacing:-.03em;text-wrap:balance; }
  .setup-heading p { margin:0;color:var(--muted); }
  .setup-refresh { display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0; }
  .setup-refresh :global(svg) { width:18px;height:18px; }
  .setup-layout { display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,1fr);gap:24px;align-items:start; }
  .setup-layout[hidden],.setup-error[hidden] { display:none; }
  .setup-checklist,.setup-next { min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:12px; }
  .checklist-header { display:flex;align-items:center;justify-content:space-between;gap:24px;padding:20px 24px;border-bottom:1px solid var(--line); }
  h3 { margin:0;font-size:1rem;font-weight:650;line-height:1.4; }
  .checklist-header p { margin:4px 0 0;color:var(--muted);font-size:.875rem;font-variant-numeric:tabular-nums; }
  progress { appearance:none;width:110px;height:6px;border:0;border-radius:4px;background:var(--line);color:var(--green);flex-shrink:0;overflow:hidden; }
  progress::-webkit-progress-bar { background:var(--line);border-radius:4px; }
  progress::-webkit-progress-value { background:var(--green);border-radius:4px; }
  progress::-moz-progress-bar { background:var(--green);border-radius:4px; }
  .setup-steps { margin:0;padding:0;list-style:none; }
  .setup-steps li+li { border-top:1px solid var(--line); }
  .setup-steps a { display:grid;grid-template-columns:32px minmax(0,1fr) auto 16px;align-items:center;gap:14px;min-height:82px;padding:14px 24px;text-decoration:none;color:var(--ink); }
  .setup-steps li:last-child a { border-radius:0 0 12px 12px; }
  .setup-steps a:hover { background:var(--paper); }
  .setup-steps a:focus-visible { outline-offset:-4px; }
  .setup-steps .is-next a { background:var(--green-soft); }
  .step-marker { display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--line);border-radius:50%;color:var(--muted);font-size:.875rem;font-weight:600;background:var(--surface); }
  .step-marker svg { display:none;width:18px;height:18px; }
  .is-complete .step-marker { border-color:var(--green);background:var(--green);color:var(--surface); }
  .is-complete .step-number { display:none; }.is-complete .step-marker svg { display:block; }
  .is-complete .step-description { display:none; }
  .is-next .step-marker { border-color:var(--green);color:var(--green); }
  .step-copy { min-width:0; }.step-title { display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:.9375rem;font-weight:600; }
  .step-description { display:block;margin-top:3px;color:var(--muted);font-size:.875rem;line-height:1.45; }
  .is-next .step-description { color:var(--green); }
  .optional-label { color:var(--muted);font-size:.75rem;font-weight:400; }
  .step-status { color:var(--muted);font-size:.75rem;white-space:nowrap; }.is-complete .step-status,.is-next .step-status { color:var(--green);font-weight:600; }
  .step-arrow { width:16px;height:16px;color:var(--muted); }.is-next .step-arrow { color:var(--green); }
  .setup-next { padding:24px; }.next-task { font-size:1.625rem;font-weight:650;letter-spacing:-.03em;line-height:1.3;margin:0 0 12px;text-wrap:balance;overflow-wrap:anywhere; }
  .next-description { margin:0 0 24px;color:var(--muted);font-size:.9375rem;line-height:1.6; }
  .next-action { gap:10px; }.next-action svg { width:18px;height:18px;flex-shrink:0; }
  .next-note { margin:16px 0 0;color:var(--muted);font-size:.875rem; }
  .setup-error { margin-bottom:16px;color:var(--error);background:#f7e7e2;padding:12px 16px;border-radius:8px; }
  .setup-announcement { position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap; }
  @media(max-width:1100px) { .setup-layout { grid-template-columns:minmax(0,1.5fr) minmax(240px,1fr);gap:16px; }.setup-steps a { padding-inline:16px;gap:10px; }.checklist-header { padding-inline:16px;gap:12px; }progress { width:70px; }.step-status { position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%); }.setup-steps a { grid-template-columns:32px minmax(0,1fr) 16px; } }
  @media(max-width:760px) { .setup-heading { gap:12px;margin-bottom:20px; }h2 { font-size:1.25rem; }.setup-heading p { font-size:.875rem; }.setup-refresh { width:44px;height:44px;padding:0; }.setup-refresh span { display:none; }.setup-refresh { font-size:0; }.setup-layout { grid-template-columns:1fr;gap:16px; }.setup-next { grid-row:1;padding:20px; }.next-task { font-size:1.25rem;margin:0 0 8px; }.next-description { margin-bottom:16px;font-size:.875rem; }.next-note { display:none; }.setup-steps a { padding-block:16px; }.checklist-header { padding-block:16px; }.step-description { font-size:.875rem; } }
  @media(min-width:761px) and (max-height:800px) { h2 { font-size:1.25rem; }.setup-heading { margin-bottom:12px; }.setup-heading p { font-size:.875rem; }.setup-steps a { min-height:64px;padding:8px 16px;grid-template-columns:32px minmax(0,1fr) 16px;gap:12px; }.step-status { position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%); }.checklist-header { padding:12px 16px; } }
</style>
