---
import RefreshIcon from './RefreshIcon.astro';
import Icon from './Icon.astro';
import { setupGuide, type SetupProgress } from '../lib/setup-guide';
interface Props { role: 'admin' | 'user'; progress: SetupProgress | null }
const { role, progress } = Astro.props;
const base = role === 'admin' ? '/admin' : '/app';
const guide = progress && setupGuide(progress, base);
const placeholder = setupGuide({ companyName: '', whatsapp: false, courier: false, leads: false, media: false, campaign: false, importing: false }, base);
const steps = guide?.steps ?? placeholder.steps;
---
<section class="setup-dashboard" data-base={base} data-initial={JSON.stringify(progress)} aria-labelledby="setup-title">
  <div class="setup-heading">
    <div><h2 id="setup-title">{guide?.complete ? 'Your business is set up' : 'Get ready to send your first offer'}</h2><p>Follow the steps below. Completed steps tick automatically.</p></div>
    <button class="secondary setup-refresh" type="button" aria-label="Refresh setup progress"><RefreshIcon /><span>Refresh</span></button>
  </div>
  <div class="setup-error form-error" role="alert" hidden={Boolean(progress)}>Couldn’t load your setup progress. Try Refresh.</div>
  <p class="setup-announcement sr-only" role="status" aria-live="polite"></p>
  <div class="setup-layout" hidden={!progress}>
    <section class="setup-next" aria-labelledby="next-title">
      <div class="paar" aria-hidden="true"></div>
      <div class="anchal-field" aria-hidden="true"></div>
      <div class="next-body">
        <h3 id="next-title" class="next-task">{guide?.next?.title ?? 'Keep your customers coming back'}</h3>
        <p class="next-description">{guide?.next?.description ?? 'Your first campaign is launched. Open Campaigns to follow its progress or create another offer.'}</p>
        <a class="primary next-action" href={guide?.next?.href ?? `${base}/campaigns`}>{guide?.next?.action ?? 'Open Campaigns'}<Icon name="arrowRight" /></a>
        <p class="next-note">{guide?.complete ? 'You can revisit any step to update your settings.' : 'You can return to this dashboard at any time to continue.'}</p>
      </div>
      <div class="paar" aria-hidden="true"></div>
    </section>
    <section class="setup-checklist panel" aria-labelledby="checklist-title">
      <div class="panel-header checklist-header"><h3 id="checklist-title">Setup checklist</h3><p id="setup-count">{guide?.completed} of {guide?.total} required steps complete</p><progress id="setup-progress" class="sr-only" value={guide?.completed ?? 0} max="5" aria-labelledby="setup-count"></progress></div>
      <ol class="setup-steps">
        {steps.map((step, index) => <li data-step={step.id} class:list={{ 'is-complete': step.complete, 'is-next': step.id === guide?.next?.id, 'is-waiting': step.id === guide?.next?.id && progress?.importing && step.id === 'leads' }}>
          <a href={step.href} aria-current={step.id === guide?.next?.id ? 'step' : undefined}>
            <span class="step-marker" aria-hidden="true"><span class="step-number">{index + 1}</span><Icon name="check" /></span>
            <span class="step-copy"><span class="step-title">{step.title}{step.optional && <span class="optional-label">Optional</span>}</span><span class="step-description">{step.description}</span></span>
            <span class="step-status">{step.complete ? 'Done' : step.id === guide?.next?.id ? progress?.importing && step.id === 'leads' ? 'Importing' : 'Up next' : step.optional ? '' : 'To do'}</span>
            <Icon name="chevronRight" class="step-arrow" />
          </a>
        </li>)}
      </ol>
    </section>
  </div>
</section>
<script>
  import { setupGuide, type SetupProgress } from '../lib/setup-guide';
  import { setButtonBusy } from '../lib/control-state';
  const root = document.querySelector<HTMLElement>('.setup-dashboard')!;
  const base = root.dataset.base as '/admin' | '/app';
  const refresh = root.querySelector<HTMLButtonElement>('.setup-refresh')!;
  const error = root.querySelector<HTMLElement>('.setup-error')!;
  const announcement = root.querySelector<HTMLElement>('.setup-announcement')!;
  let previous = root.dataset.initial!;
  let busy = false;
  let active = true;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let controller: AbortController | undefined;
  const setText = (selector: string, value: string) => { root.querySelector<HTMLElement>(selector)!.textContent = value; };
  function render(progress: SetupProgress) {
    const guide = setupGuide(progress, base);
    root.querySelector<HTMLElement>('.setup-layout')!.hidden = false;
    setText('#setup-title', guide.complete ? 'Your business is set up' : 'Get ready to send your first offer');
    setText('#setup-count', `${guide.completed} of ${guide.total} required steps complete`);
    root.querySelector<HTMLProgressElement>('#setup-progress')!.value = guide.completed;
    for (const step of guide.steps) {
      const row = root.querySelector<HTMLElement>(`[data-step="${step.id}"]`)!;
      const next = guide.next?.id === step.id;
      if (step.complete && !row.classList.contains('is-complete')) row.classList.add('just-completed');
      row.classList.toggle('is-complete', step.complete);
      row.classList.toggle('is-next', next);
      row.classList.toggle('is-waiting', next && progress.importing && step.id === 'leads');
      const link = row.querySelector('a')!;
      if (next) link.setAttribute('aria-current', 'step'); else link.removeAttribute('aria-current');
      row.querySelector('.step-description')!.textContent = step.description;
      row.querySelector('.step-status')!.textContent = step.complete ? 'Done' : next ? progress.importing && step.id === 'leads' ? 'Importing' : 'Up next' : step.optional ? '' : 'To do';
    }
    setText('#next-title', guide.next?.title ?? 'Keep your customers coming back');
    setText('.next-description', guide.next?.description ?? 'Your first campaign is launched. Open Campaigns to follow its progress or create another offer.');
    const link = root.querySelector<HTMLAnchorElement>('.next-action')!;
    link.href = guide.next?.href ?? `${base}/campaigns`;
    link.firstChild!.textContent = guide.next?.action ?? 'Open Campaigns';
    setText('.next-note', guide.complete ? 'You can revisit any step to update your settings.' : 'You can return to this dashboard at any time to continue.');
    return guide;
  }
  function schedule() {
    clearTimeout(timer);
    if (active && !document.hidden) timer = setTimeout(() => void update(), 30000);
  }
  async function update(manual = false) {
    if (busy || !active) return;
    clearTimeout(timer);
    busy = true;
    controller = new AbortController();
    const timeout = setTimeout(() => controller?.abort(), 10000);
    if (manual) { setButtonBusy(refresh, true, false, 'Refreshing…'); root.setAttribute('aria-busy', 'true'); }
    try {
      const response = await fetch('/api/setup-progress', { cache: 'no-store', signal: controller.signal });
      if (response.status === 401) throw new Error('Your session has expired. Log in again to check your progress.');
      if (!response.ok) throw new Error('Couldn’t refresh your setup progress. Try Refresh.');
      const progress: SetupProgress = await response.json();
      const guide = render(progress);
      error.hidden = true;
      const current = JSON.stringify(progress);
      if (manual || current !== previous) announcement.textContent = guide.complete ? 'All required setup steps are complete.' : `${guide.completed} of ${guide.total} required steps complete. Next: ${guide.next!.title}.`;
      previous = current;
    } catch (cause) {
      if (!active) return;
      error.textContent = cause instanceof Error && cause.name !== 'AbortError' ? cause.message : 'Couldn’t refresh your setup progress. Try Refresh.';
      error.hidden = false;
    } finally {
      clearTimeout(timeout);
      busy = false;
      setButtonBusy(refresh, false);
      root.removeAttribute('aria-busy');
      schedule();
    }
  }
  refresh.addEventListener('click', () => void update(true));
  const acknowledge = (event: Event) => (event.target as Element).closest('.just-completed')?.classList.remove('just-completed');
  root.addEventListener('pointerover', acknowledge);
  root.addEventListener('focusin', acknowledge);
  document.addEventListener('visibilitychange', () => { clearTimeout(timer); if (!document.hidden) void update(); });
  window.addEventListener('pagehide', () => { active = false; clearTimeout(timer); controller?.abort(); });
  window.addEventListener('pageshow', event => { active = true; if (event.persisted) void update(); else schedule(); });
  schedule();
</script>
<style>
  .setup-heading { display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px; }
  h2 { margin-bottom:4px;font-size:var(--fs-2xl);font-weight:640;letter-spacing:-.025em; }
  .setup-heading p { color:var(--ink-2); }
  .setup-error { margin-bottom:16px; }
  .setup-layout { display:grid;grid-template-columns:minmax(300px,.85fr) minmax(0,1.4fr);gap:20px;align-items:stretch; }

  .setup-next { position:relative;display:flex;flex-direction:column;overflow:hidden;min-width:0;padding-block:14px;border-radius:var(--r-lg);background:var(--anchal);color:var(--anchal-thread); }
  .setup-next > .paar { flex:none;height:18px; }
  .setup-next > .paar::after { border-color:var(--anchal-thread);opacity:.35; }
  .setup-next > .anchal-field { inset:32px 0; }
  .next-body { position:relative;display:flex;flex:1;flex-direction:column;align-items:flex-start;justify-content:center;padding:28px 24px; }
  .next-task { margin-bottom:8px;color:#fff;font-size:var(--fs-2xl);font-weight:640;letter-spacing:-.025em;overflow-wrap:anywhere; }
  .next-description { margin-bottom:22px;color:color-mix(in srgb, var(--anchal-thread) 82%, transparent);line-height:1.55; }
  .next-action { min-height:48px;padding-inline:20px;font-size:var(--fs-md); }
  .next-action :global(svg) { transition:transform var(--dur-2) var(--ease-out); }
  .next-action:hover :global(svg) { transform:translateX(3px); }
  .next-action:focus-visible { outline-color:#fff; }
  .next-note { margin-top:16px;color:color-mix(in srgb, var(--anchal-thread) 72%, transparent);font-size:var(--fs-sm); }

  .checklist-header { flex-wrap:wrap;row-gap:2px; }
  .checklist-header p { color:var(--ink-2);font-size:var(--fs-sm); }
  .setup-steps { margin:0;padding:6px 0;list-style:none; }
  .setup-steps li { position:relative; }
  /* The warp thread: each step carries the halves of the thread entering and leaving its booti. */
  .setup-steps li::before,.setup-steps li::after { content:'';position:absolute;z-index:1;left:35px;width:2px;height:50%;background:var(--line);transform-origin:top; }
  .setup-steps li::before { top:0; }.setup-steps li::after { top:50%; }
  .setup-steps li:first-child::before,.setup-steps li:last-child::after { display:none; }
  .setup-steps li.is-complete::after,.setup-steps li.is-complete+li::before { background:var(--success); }
  .setup-steps li.just-completed::after { animation:thread-draw var(--dur-2) var(--ease-out) 160ms both; }
  .setup-steps li.just-completed+li::before { animation:thread-draw var(--dur-2) var(--ease-out) 300ms both; }
  .setup-steps a { position:relative;display:grid;grid-template-columns:28px minmax(0,1fr) auto 18px;align-items:center;gap:14px;min-height:68px;margin:0 6px;padding:10px 12px 10px 16px;border-radius:var(--r-md);color:var(--ink);text-decoration:none;transition:background-color var(--dur-1) var(--ease-out); }
  .setup-steps a:hover { background:var(--surface-2); }
  .setup-steps a:focus-visible { outline-offset:-2px; }
  .setup-steps .is-next a { background:var(--accent-soft); }
  .setup-steps .just-completed a { background:var(--success-soft); }
  .step-marker { position:relative;z-index:2;display:grid;place-items:center;width:28px;height:28px;color:var(--ink-3);font-size:var(--fs-xs);font-weight:650; }
  .step-marker::before { content:'';position:absolute;inset:5px;border:1.5px solid var(--line-strong);border-radius:4px;background:var(--surface);transform:rotate(45deg);transition:background-color var(--dur-2) var(--ease-out),border-color var(--dur-2) var(--ease-out); }
  .step-number,.step-marker :global(svg) { position:relative; }
  .step-marker :global(svg) { display:none;width:13px;height:13px;stroke-width:2.6; }
  .is-complete .step-marker { color:#fff; }
  .is-complete .step-marker::before { border-color:var(--success);background:var(--success); }
  .is-complete .step-number { display:none; }.is-complete .step-marker :global(svg) { display:block; }
  .just-completed .step-marker::before { animation:booti-fill var(--dur-3) var(--ease-out); }
  .is-next .step-marker { color:var(--accent-fg); }
  .is-next .step-marker::before { border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft); }
  .step-copy { min-width:0; }
  .step-title { display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;font-weight:600; }
  .step-description { display:block;margin-top:2px;color:var(--ink-2);font-size:var(--fs-sm);line-height:1.45; }
  .is-complete .step-description { display:none; }
  .optional-label { color:var(--ink-3);font-size:var(--fs-xs);font-weight:500; }
  .step-status { color:var(--ink-3);font-size:var(--fs-xs);font-weight:560;white-space:nowrap; }
  .is-complete .step-status { color:var(--success);font-weight:650; }
  .is-next .step-status { color:var(--accent-fg);font-weight:650; }
  .step-arrow { width:18px;height:18px;color:var(--ink-3); }
  .is-next .step-arrow { color:var(--accent-fg); }
  .setup-steps .is-waiting a { background:var(--warning-soft); }
  .is-waiting .step-marker { color:var(--warning); }
  .is-waiting .step-marker::before { border-color:var(--warning-mark);box-shadow:0 0 0 3px var(--warning-soft); }
  .is-waiting .step-status,.is-waiting .step-arrow { color:var(--warning); }
  @media (prefers-color-scheme: dark) { .is-complete .step-marker { color:var(--ground); } }
  @keyframes booti-fill { from { transform:rotate(45deg) scale(.4);background:var(--surface); } }
  @keyframes thread-draw { from { transform:scaleY(0); } }

  @media(max-width:1100px) { .setup-layout { grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:16px; }.step-status { position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%); }.setup-steps a { grid-template-columns:28px minmax(0,1fr) 18px; } }
  @media(max-width:900px) { .setup-layout { grid-template-columns:1fr; }.setup-next { padding-block:10px; }.setup-next > .anchal-field { inset:28px 0; }.next-body { padding:18px 20px; } }
  @media(max-width:760px) { .setup-heading { gap:12px;margin-bottom:16px; }h2 { font-size:var(--fs-xl); }.setup-heading p { font-size:var(--fs-sm); }.setup-refresh { width:44px;padding:0; }.setup-refresh span { display:none; }.next-task { font-size:var(--fs-xl); }.next-description { margin-bottom:16px;font-size:var(--fs-sm); }.next-note { display:none; }.next-action { width:100%; }.setup-steps a { margin-inline:4px;padding-inline:12px; }.setup-steps li::before,.setup-steps li::after { left:29px; } }
  @media(min-width:761px) and (max-height:800px) { h2 { font-size:var(--fs-xl); }.setup-heading { margin-bottom:14px; }.setup-steps a { min-height:58px;padding-block:6px; }.next-body { padding-block:22px; } }
</style>
