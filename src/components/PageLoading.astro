---
import Skeleton from './Skeleton.astro';
interface Props { auth?: boolean }
const { auth = false } = Astro.props;
const variants = auth ? ['auth'] as const : ['dashboard','leads','campaigns','users','account','courier','whatsapp','campaign-editor','campaign-detail'] as const;
---
<div id="page-loading" hidden>
  <span class="loading-announcement" id="page-loading-status" role="status" aria-live="polite"></span>
  {variants.map(variant => <template data-page-skeleton={variant}><Skeleton variant={variant} /></template>)}
  <div id="page-loading-content"></div>
</div>
<script>
  import { initPageLoading } from '../lib/page-loading';
  initPageLoading();
</script>
<style is:global>
  main:has(#page-loading) { position:relative; }
  #page-loading { position:absolute;inset:0;z-index:1;min-height:100%;padding:inherit;background:var(--ground); }
  main.page-pending > :not(#page-loading) { visibility:hidden; }
  .workspace:has(main.page-pending) .header-actions,.workspace:has(main.page-pending) .header-title>:not(h1) { visibility:hidden; }
</style>
