---
import { iconPaths, type IconName } from '../lib/icons';
interface Props { name: IconName; class?: string; size?: number }
const { name, class: className, size } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconPaths[name]} /></svg>
