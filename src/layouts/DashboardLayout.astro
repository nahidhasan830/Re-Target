---
import Head from '../components/Head.astro';
import BrandMark from '../components/BrandMark.astro';
import Icon from '../components/Icon.astro';
import CampaignStyles from '../components/CampaignStyles.astro';
import PageLoading from '../components/PageLoading.astro';
import type { IconName } from '../lib/icons';
type Section = 'dashboard' | 'media' | 'campaigns' | 'leads' | 'whatsapp' | 'courier' | 'account' | 'users';
interface Props { title: string; active: Section; phone: string; role?: 'admin' | 'user'; companyName?: string; focus?: boolean }
const { title, active, role = 'admin', focus = false } = Astro.props;
const base = role === 'admin' ? '/admin' : '/app';
Astro.response.headers.set('Cache-Control', 'no-store');
type Item = { key: Section; label: string; href: string; icon: IconName; tab?: string };
const groups: { label?: string; items: Item[] }[] = [
  { items: [{ key: 'dashboard', label: 'Dashboard', href: base, icon: 'home', tab: 'Home' }] },
  { label: 'Outreach', items: [
    { key: 'campaigns', label: 'Campaigns', href: `${base}/campaigns`, icon: 'campaigns', tab: 'Campaigns' },
    { key: 'leads', label: 'Leads', href: `${base}/leads`, icon: 'leads', tab: 'Leads' },
    { key: 'media', label: 'Media', href: `${base}/media`, icon: 'media', tab: 'Media' },
  ] },
  { label: 'Channels', items: [
    { key: 'whatsapp', label: 'WhatsApp', href: `${base}/whatsapp`, icon: 'whatsapp' },
    { key: 'courier', label: 'Courier', href: `${base}/courier`, icon: 'courier' },
  ] },
  ...(role === 'admin' ? [{ label: 'Admin', items: [{ key: 'users', label: 'Users', href: '/admin/users', icon: 'users' } as Item] }] : []),
];
const items = groups.flatMap(group => group.items);
const moreItems = [...items.filter(item => !item.tab), { key: 'account', label: 'Account', href: `${base}/account`, icon: 'account' } as Item];
const current = (key: Section) => active === key ? 'page' : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <Head title={title} />
    {(active === 'campaigns' || active === 'whatsapp') && <CampaignStyles />}
  </head>
  <body data-focus={focus ? '' : undefined}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <aside class="sidebar" aria-label="Dashboard sidebar">
      <div class="paar" aria-hidden="true"></div>
      <div class="sidebar-brand"><a class="brand" href={base} aria-label="Re-Target dashboard"><BrandMark />Re-Target</a><span class="chip plain role">{role === 'admin' ? 'Admin' : 'User'}</span></div>
      <nav class="nav" aria-label="Main navigation">
        {groups.map(group => <>
          {group.label && <p class="nav-group">{group.label}</p>}
          {group.items.map(item => <a class="nav-link" href={item.href} aria-current={current(item.key)}><Icon name={item.icon} />{item.label}</a>)}
        </>)}
      </nav>
      <div class="sidebar-footer">
        <a class="nav-link account-link" href={`${base}/account`} aria-current={current('account')}><Icon name="account" />Account</a>
        <form method="post" action="/api/logout" data-logout><button class="icon-button" type="submit" aria-label="Log out" title="Log out"><Icon name="logout" /></button></form>
      </div>
    </aside>
    <div class="workspace">
      <header class="topbar"><a class="topbar-brand" href={base} aria-label="Re-Target dashboard"><BrandMark /></a><slot name="header-leading" /><div class="header-title"><h1>{title}</h1><slot name="header-meta" /></div><div class="header-actions"><slot name="header-actions" /></div></header>
      <main id="main-content" tabindex="-1"><slot /><PageLoading /></main>
    </div>
    {!focus && <>
      <nav class="tabbar" aria-label="Main navigation">
        {items.filter(item => item.tab).map(item => <a class="tab" href={item.href} aria-current={current(item.key)}><Icon name={item.icon} />{item.tab}</a>)}
        <button class="tab" type="button" aria-haspopup="dialog" aria-controls="more-sheet" aria-expanded="false" data-current={moreItems.some(item => item.key === active) ? '' : undefined}><Icon name="more" />More</button>
      </nav>
      <dialog class="more-sheet" id="more-sheet" aria-labelledby="more-title">
        <div class="paar" aria-hidden="true"></div>
        <div class="sheet-head"><h2 id="more-title">More</h2><button class="icon-button" type="button" data-sheet-close aria-label="Close menu"><Icon name="close" /></button></div>
        <nav class="sheet-nav" aria-label="More">
          {moreItems.map(item => <a class="nav-link" href={item.href} aria-current={current(item.key)}><Icon name={item.icon} />{item.label}</a>)}
        </nav>
        <div class="sheet-foot">
          <form method="post" action="/api/logout" data-logout><button class="secondary" type="submit"><Icon name="logout" /><span>Log out</span></button></form>
        </div>
      </dialog>
    </>}
  </body>
</html>
<script>
  import { setButtonBusy } from '../lib/control-state';
  import { initPasswordToggles } from '../lib/password-toggle';
  initPasswordToggles();
  let loggingOut = false;
  const logoutForms = document.querySelectorAll<HTMLFormElement>('form[data-logout]');
  for (const form of logoutForms) form.addEventListener('submit', event => {
    if (loggingOut) { event.preventDefault(); return; }
    loggingOut = true;
    form.setAttribute('aria-busy', 'true');
    setButtonBusy(form.querySelector('button')!, true, false, 'Logging out…');
  });
  window.addEventListener('pageshow', () => {
    loggingOut = false;
    for (const form of logoutForms) { form.removeAttribute('aria-busy'); setButtonBusy(form.querySelector('button')!, false); }
  });

  const sheet = document.querySelector<HTMLDialogElement>('#more-sheet');
  const moreButton = document.querySelector<HTMLButtonElement>('[aria-controls="more-sheet"]');
  if (sheet && moreButton) {
    const sync = () => {
      moreButton.setAttribute('aria-expanded', String(sheet.open));
      document.documentElement.classList.toggle('sheet-open', sheet.open);
    };
    moreButton.addEventListener('click', () => { sheet.showModal(); sync(); });
    sheet.addEventListener('close', sync);
    sheet.addEventListener('click', event => {
      const target = event.target as Element;
      const bounds = sheet.getBoundingClientRect();
      const outside = event.clientY < bounds.top || event.clientX < bounds.left || event.clientX > bounds.right;
      if (target === sheet && outside || target.closest('[data-sheet-close], a')) sheet.close();
    });
    window.matchMedia('(max-width: 760px)').addEventListener('change', event => { if (!event.matches) sheet.close(); });
  }
</script>
