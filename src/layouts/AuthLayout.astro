---
import Head from '../components/Head.astro';
import BrandMark from '../components/BrandMark.astro';
import PageLoading from '../components/PageLoading.astro';
interface Props { title: string }
const { title } = Astro.props;
Astro.response.headers.set('Cache-Control', 'no-store');
// Jamdani motifs are woven on a grid, so the centre motif is drawn cell by cell.
const span = 10;
const cells: { x: number; y: number; rani: boolean }[] = [];
for (let y = -span; y <= span; y++) for (let x = -span; x <= span; x++) {
  const d = Math.abs(x) + Math.abs(y);
  const rani = d <= 2 || d === 4 && (x === 0 || y === 0);
  if (rani || d === 6 || d === 8 && (x + y) % 2 === 0 || d === span) cells.push({ x: x + span, y: y + span, rani });
}
---
<!doctype html>
<html lang="en">
  <head><Head title={title} /></head>
  <body>
    <div class="auth">
      <div class="auth-main">
        <a class="brand" href="/" aria-label="Re-Target home"><BrandMark />Re-Target</a>
        <main><slot /><PageLoading auth /></main>
      </div>
      <div class="anchal" aria-hidden="true">
        <div class="paar"></div>
        <div class="anchal-field"></div>
        <svg class="anchal-motif" viewBox="0 0 189 189">{cells.map(cell => <rect class:list={{ rani: cell.rani }} x={cell.x * 9} y={cell.y * 9} width="8" height="8" rx="1" fill="currentColor" />)}</svg>
        <div class="paar"></div>
      </div>
    </div>
  </body>
</html>
<script>
  import { initPasswordToggles } from '../lib/password-toggle';
  initPasswordToggles();
</script>
