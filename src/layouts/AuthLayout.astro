---
import PageLoading from '../components/PageLoading.astro';
import ControlStates from '../components/ControlStates.astro';
import FeedbackStyles from '../components/FeedbackStyles.astro';
interface Props { title: string }
const { title } = Astro.props;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Re-Target</title>
    <ControlStates />
    <FeedbackStyles />
  </head>
  <body>
    <header><a class="brand" href="/" aria-label="Re-Target home"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M25 12a10 10 0 1 0 1 7M25 5v7h-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="16" cy="16" r="3" fill="currentColor"/></svg>Re-Target</a></header>
    <main><slot /><PageLoading auth /></main>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; --paper: #f6f5f0; --ink: #202a26; --muted: #52605a; --green: #17603d; --line: #b9c2b9; --error: #a12b29; }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100svh; display: flex; flex-direction: column; background: var(--paper); color: var(--ink); font-family: system-ui, sans-serif; line-height: 1.6; }
  ::selection { background: #c8dfc9; color: var(--ink); }
  header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 28px clamp(24px, 5vw, 72px); }
  .brand { display: inline-flex; gap: 9px; align-items: center; font-size: 1.25rem; font-weight: 650; letter-spacing: -.03em; color: var(--ink); text-decoration: none; }
  .brand svg { width: 30px; height: 30px; color: var(--green); }
  main { flex: 1; width: min(420px, calc(100% - 48px)); margin: 0 auto; padding: clamp(36px, 9vh, 100px) 0 64px; }
  h1 { font-size: clamp(2.25rem, 7vw, 2.75rem); font-weight: 600; line-height: 1.15; letter-spacing: -.035em; margin: 0 0 14px; text-wrap: balance; }
  .intro { color: var(--muted); margin: 0 0 32px; }
  a { color: var(--green); text-underline-offset: 3px; }
  button, input { font: inherit; }
  input { caret-color: var(--green); }
  :focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
  .primary { width: 100%; min-height: 50px; padding: 12px 20px; border: 1px solid var(--green); border-radius: 8px; color: #fff; background: var(--green); font-weight: 600; cursor: pointer; }
  .primary:hover:not(:disabled) { background: #124b30; border-color: #124b30; }
  .primary:disabled { opacity: .7; }
  @media (max-width: 420px) { header { padding: 24px; } }
</style>
