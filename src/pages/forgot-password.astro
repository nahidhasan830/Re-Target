---
import AuthLayout from '../layouts/AuthLayout.astro';
import { limitLogin, requireSameOrigin } from '../lib/auth';
import { HttpError, readBody } from '../lib/http';
import { validateResetRequest } from '../lib/login-validation';
import { requestPasswordReset } from '../lib/password-resets';

const queryPhone = Astro.url.searchParams.get('phone') ?? '';
let phone = /^01[0-9]{9}$/.test(queryPhone) ? queryPhone : '';
const sent = Astro.url.searchParams.has('sent') && Boolean(phone);
let error = '';
let message = '';
if (Astro.request.method === 'POST') {
  try {
    requireSameOrigin(Astro.request);
    if (Astro.request.headers.get('content-type')?.split(';')[0] !== 'application/x-www-form-urlencoded') throw new HttpError(415, 'Refresh the page and try again.');
    phone = new URLSearchParams(await readBody(Astro.request)).get('phone') ?? '';
    const validated = validateResetRequest(phone);
    if (!validated.result.success) {
      error = validated.error ?? '';
      Astro.response.status = 400;
    } else {
      await limitLogin(Astro.request, 'password-reset', 5);
      // Sending after the response keeps timing identical whether or not the number has an account.
      Astro.locals.cfContext.waitUntil(requestPasswordReset(validated.result.data, Astro.url.origin)
        .catch(() => console.error(JSON.stringify({ event: 'password_reset_failed' }))));
      return Astro.redirect(`/forgot-password?sent&phone=${validated.result.data}`, 303);
    }
  } catch (caught) {
    Astro.response.status = caught instanceof HttpError ? caught.status : 503;
    message = caught instanceof HttpError ? caught.message : 'Couldn’t send a reset link. Try again shortly.';
    if (Astro.response.status === 429) Astro.response.headers.set('Retry-After', '900');
  }
}
---
<AuthLayout title={sent ? 'Check WhatsApp' : 'Reset password'}>
  {sent ? <>
    <h1>Check WhatsApp</h1>
    <p class="intro" role="status">If {phone} has an account, you’ll get a reset link on WhatsApp shortly. It expires in 30 minutes.</p>
    <a class="primary login-link" href={`/?phone=${phone}`}>Back to login</a>
  </> : <>
    <h1>Reset password</h1>
    <form method="post" action="/forgot-password" id="reset-request-form">
      {message && <p class="form-error" role="alert">{message}</p>}
      <div class="field">
        <label for="phone">Phone number</label>
        <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="username" placeholder="01XXXXXXXXX" value={phone} required pattern="01[0-9]{9}" aria-invalid={error ? 'true' : undefined} aria-describedby="phone-error" />
        <p class="field-error" id="phone-error" aria-live="polite" hidden={!error}>{error}</p>
      </div>
      <button class="primary" type="submit" id="reset-request-submit">Send reset link</button>
      <p id="reset-request-status" class="status" role="status"></p>
    </form>
    <a class="back-link" href={phone ? `/?phone=${phone}` : '/'}>Back to login</a>
  </>}
</AuthLayout>
<script>
  import { validateResetRequest } from '../lib/login-validation';
  const form = document.querySelector<HTMLFormElement>('#reset-request-form');
  if (form) {
    const phone = document.querySelector<HTMLInputElement>('#phone')!;
    const error = document.querySelector<HTMLElement>('#phone-error')!;
    const submit = document.querySelector<HTMLButtonElement>('#reset-request-submit')!;
    const status = document.querySelector<HTMLElement>('#reset-request-status')!;
    form.noValidate = true;
    let submitting = false;
    function showError(message?: string) {
      error.textContent = message ?? '';
      error.hidden = !message;
      phone.setAttribute('aria-invalid', String(Boolean(message)));
    }
    phone.addEventListener('blur', () => { if (phone.value) showError(validateResetRequest(phone.value).error); });
    phone.addEventListener('input', () => {
      if (phone.getAttribute('aria-invalid') === 'true') showError(validateResetRequest(phone.value).error);
      const oldError = form.querySelector<HTMLElement>('.form-error');
      if (oldError) oldError.hidden = true;
    });
    form.addEventListener('submit', (event) => {
      if (submitting) { event.preventDefault(); return; }
      const validated = validateResetRequest(phone.value);
      showError(validated.error);
      if (!validated.result.success) { event.preventDefault(); phone.focus(); return; }
      phone.value = validated.result.data;
      submitting = true;
      submit.disabled = true;
      submit.textContent = 'Sending…';
      status.textContent = 'Sending your reset link…';
      form.setAttribute('aria-busy', 'true');
    });
    window.addEventListener('pageshow', () => {
      submitting = false;
      submit.disabled = false;
      submit.textContent = 'Send reset link';
      status.textContent = '';
      form.removeAttribute('aria-busy');
    });
    form.querySelector<HTMLInputElement>('[aria-invalid="true"]')?.focus();
  }
</script>
<style>
  .status:empty { display: none; }
  .back-link { align-self: center; margin-top: 12px; padding: 12px; font-size: var(--fs-sm); }
</style>
