---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import WhatsAppSettings from '../../components/WhatsAppSettings.astro';
import SenderPause from '../../components/SenderPause.astro';
import { currentAdmin } from '../../lib/auth';
const admin = await currentAdmin(Astro.cookies);
if (!admin) return Astro.redirect('/', 302);
---
<DashboardLayout title="WhatsApp" active="whatsapp" phone={admin.phone} companyName={admin.companyName}>
  <WhatsAppSettings><SenderPause /></WhatsAppSettings>
</DashboardLayout>
