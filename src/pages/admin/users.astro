---
import RefreshIcon from '../../components/RefreshIcon.astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { currentAdmin } from '../../lib/auth';
import { listInvitations } from '../../lib/invitations';
const admin = await currentAdmin(Astro.cookies);
if (!admin) return Astro.redirect('/', 302);
const data = await listInvitations();
const whatsappOutline = 'M21 11.5a9 9 0 0 1-13.4 7.9L3 21l1.6-4.6A9 9 0 1 1 21 11.5Z';
const whatsappPhone = 'M8 7.5c0 4.5 4 8.5 8.5 8.5l1-2.5-3-1-1 1c-1.7-.8-3-2.1-3.8-3.8l1-1-1-3-1.7 1.8Z';
---
<DashboardLayout title="Users" active="users" phone={admin.phone}>
  <div class="users-page">
    <div class="users-grid">
      <section class="invite-panel" aria-labelledby="invite-title">
        <div class="invite-content">
        <svg class="invite-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h7"/><path d="m3 6 9 6 9-6M18 15v6M15 18h6"/></svg>
        <h2 id="invite-title">Invite a user</h2>
        <form id="invite-form">
          <div class="phone-field"><label for="invite-phone">WhatsApp number</label><input id="invite-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="01XXXXXXXXX" required pattern="01[0-9]{9}" maxlength="11" aria-describedby="invite-error" /><p id="invite-error" class="field-error" role="alert" hidden></p></div>
          <button class="primary" type="submit" id="send-invite"><span class="send-label-wide">Send invitation</span><span class="send-label-compact">Send</span></button>
        </form>
        <p id="users-feedback" class="feedback" role="status" hidden></p>
        <p class="invite-note">Expires in 72 hours.</p>
        </div>
      </section>
      <section class="users-panel" aria-labelledby="users-title">
        <div class="list-heading"><div class="list-title"><h2 id="users-title">Invited businesses</h2><span id="users-count">{data.items.length} {data.items.length === 1 ? 'business' : 'businesses'}</span></div><button class="secondary refresh-button" id="refresh-users" type="button"><RefreshIcon /><span>Refresh</span></button></div>
        <p id="gateway-warning" class="gateway-warning" role="status" hidden>WhatsApp statuses are unavailable. <a href="/admin/whatsapp">Check your connection</a>.</p>
        <div id="users-empty" class="empty" hidden={data.items.length > 0}><h3>No businesses yet</h3><p>Send your first invitation to get started.</p></div>
        <div class="table-wrap" id="users-table-wrap" hidden={!data.items.length} tabindex="0" role="region" aria-label="Invited businesses">
      <table><caption class="sr-only">Invited businesses, account setup, and WhatsApp connections</caption><thead><tr><th scope="col">Business</th><th scope="col">Account</th><th scope="col">WhatsApp</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody id="users-list">
        {data.items.map((row) => <tr data-id={row.id}><td><strong>{row.companyName ?? row.phone}</strong>{row.companyName && <span class="detail">{row.phone}</span>}</td><td><span class="badge" data-active={String(row.status === 'accepted')}>{row.status === 'accepted' ? 'Active' : row.status === 'pending' ? 'Invited' : row.status === 'expired' ? 'Expired' : 'Revoked'}</span></td><td class="whatsapp-cell" data-active={String(row.status === 'accepted')}><div class="whatsapp-state"><div class="whatsapp-status"><span class="whatsapp-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d={whatsappOutline}/><path d={whatsappPhone} stroke-width="1.4"/></svg><span class="sr-only">WhatsApp: </span></span><span class:list={{ 'user-checking': row.status === 'accepted' }}>{row.status === 'accepted' ? 'Checking…' : 'Awaiting account setup'}</span></div></div></td><td class="actions">{row.status !== 'accepted' && <><button class="secondary" data-action="resend" data-id={row.id} type="button" aria-label={`Resend invitation for ${row.phone}`}>Resend</button>{row.status !== 'revoked' && <button class="secondary" data-action="revoke" data-id={row.id} type="button" aria-label={`Revoke invitation for ${row.phone}`}>Revoke</button>}</>}</td></tr>)}
      </tbody></table>
    </div>
    <nav class="list-pagination" aria-label="Business list pages" hidden><span id="page-range" role="status"></span><div><button id="previous-page" class="secondary" type="button" disabled>Previous</button><button id="load-more" class="secondary" type="button">Next</button></div></nav>
      </section>
    </div>
  </div>
  <template id="whatsapp-label-template"><span class="whatsapp-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d={whatsappOutline}/><path d={whatsappPhone} stroke-width="1.4"/></svg><span class="sr-only">WhatsApp: </span></span></template>
  <noscript><p>Enable JavaScript to send invitations and check WhatsApp connections.</p></noscript>
</DashboardLayout>
<script>
  import { setButtonBusy } from '../../lib/control-state';
  import { setFeedback } from '../../lib/feedback';
  import { localPhoneInput } from '../../lib/account-validation';
  import type { InvitationRow } from '../../lib/invitations';
  const form = document.querySelector<HTMLFormElement>('#invite-form')!;
  const phone = document.querySelector<HTMLInputElement>('#invite-phone')!;
  const submit = document.querySelector<HTMLButtonElement>('#send-invite')!;
  const wideSubmitLabel = submit.querySelector<HTMLElement>('.send-label-wide')!;
  const compactSubmitLabel = submit.querySelector<HTMLElement>('.send-label-compact')!;
  const fieldError = document.querySelector<HTMLElement>('#invite-error')!;
  const feedback = document.querySelector<HTMLElement>('#users-feedback')!;
  const warning = document.querySelector<HTMLElement>('#gateway-warning')!;
  const list = document.querySelector<HTMLTableSectionElement>('#users-list')!;
  const empty = document.querySelector<HTMLElement>('#users-empty')!;
  const table = document.querySelector<HTMLElement>('#users-table-wrap')!;
  const count = document.querySelector<HTMLElement>('#users-count')!;
  const refresh = document.querySelector<HTMLButtonElement>('#refresh-users')!;
  const more = document.querySelector<HTMLButtonElement>('#load-more')!;
  const previous = document.querySelector<HTMLButtonElement>('#previous-page')!;
  const pagination = document.querySelector<HTMLElement>('.list-pagination')!;
  const range = document.querySelector<HTMLElement>('#page-range')!;
  const whatsappLabelTemplate = document.querySelector<HTMLTemplateElement>('#whatsapp-label-template')!;
  const compact = matchMedia('(max-width: 1100px), (max-height: 599px)');
  let pageIndex = 0;
  let pageSize = compact.matches ? 5 : 25;
  let rows: InvitationRow[] = [];
  let cursor: string | null = null;
  let sending = false;
  let loading = false;
  let requestId = crypto.randomUUID();
  let pendingPhone = '';
  const actionRequests = new Map<string, string>();
  form.noValidate = true;

  async function api<T>(path: string, body?: unknown) {
    const response = await fetch(path, { method: body === undefined ? 'GET' : 'POST', cache: 'no-store', signal: AbortSignal.timeout(45000),
      ...(body === undefined ? {} : { headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }) });
    if (response.status === 401) { location.assign('/'); throw new Error('Log in to continue.'); }
    const data = await response.json() as T & { error?: string };
    if (!response.ok) throw new Error(data.error ?? 'Couldn’t complete the request. Try again.');
    return data;
  }
  function message(text: string, error = false, success = '') { setFeedback(feedback, text, success); feedback.hidden = !text; feedback.dataset.error = String(error); }
  function render(resetScroll = false) {
    const scrollTop = table.scrollTop;
    list.replaceChildren();
    const cachedPages = cursor ? Math.floor(rows.length / pageSize) : Math.ceil(rows.length / pageSize);
    pageIndex = Math.min(pageIndex, Math.max(0, cachedPages - 1));
    const start = pageIndex * pageSize;
    for (const row of rows.slice(start, start + pageSize)) {
      const tr = document.createElement('tr'); tr.dataset.id = row.id;
      const business = document.createElement('td');
      const name = document.createElement('strong'); name.textContent = row.companyName ?? row.phone; business.appendChild(name);
      if (row.companyName) { const value = document.createElement('span'); value.className = 'detail'; value.textContent = row.phone; business.appendChild(value); }
      const account = document.createElement('td');
      const badge = document.createElement('span'); badge.className = 'badge'; badge.dataset.active = String(row.status === 'accepted');
      badge.textContent = ({ accepted: 'Active', pending: 'Invited', expired: 'Expired', revoked: 'Revoked' } as Record<string, string>)[row.status] ?? row.status;
      account.appendChild(badge);
      if (row.status !== 'accepted') {
        const detail = document.createElement('span'); detail.className = 'detail';
        detail.textContent = ({ sent: 'Sent on WhatsApp', sending: 'Sending…', failed: 'Sending failed', unknown: 'Send unconfirmed' } as Record<string, string>)[row.deliveryStatus] ?? '';
        account.appendChild(detail);
        if (row.deliveryError) { detail.title = row.deliveryError; }
      }
      const whatsapp = document.createElement('td'); whatsapp.className = 'whatsapp-cell'; whatsapp.dataset.active = String(row.status === 'accepted'); whatsapp.dataset.connected = String(row.whatsappStatus === 'WORKING');
      const whatsappLabel = whatsappLabelTemplate.content.firstElementChild!.cloneNode(true);
      const whatsappState = document.createElement('div'); whatsappState.className = 'whatsapp-state';
      const whatsappStatus = document.createElement('span'); whatsappStatus.textContent = row.status !== 'accepted' ? 'Awaiting account setup' : row.whatsappStatus === 'WORKING' ? 'Connected' : row.whatsappStatus === 'UNKNOWN' ? 'Unavailable' : ['STARTING', 'SCAN_QR_CODE'].includes(row.whatsappStatus ?? '') ? 'Connecting' : 'Not connected';
      const whatsappStatusGroup = document.createElement('div'); whatsappStatusGroup.className = 'whatsapp-status';
      whatsappStatusGroup.appendChild(whatsappLabel); whatsappStatusGroup.appendChild(whatsappStatus); whatsappState.appendChild(whatsappStatusGroup);
      if (row.status === 'accepted' && row.whatsappStatus === 'WORKING' && row.whatsappPhone) { const value = document.createElement('span'); value.className = 'detail'; value.dataset.samePhone = String(row.whatsappPhone === row.phone); value.textContent = row.whatsappPhone; whatsappState.appendChild(value); }
      whatsapp.appendChild(whatsappState);
      const actions = document.createElement('td'); actions.className = 'actions';
      if (row.status !== 'accepted') for (const action of row.status === 'revoked' ? ['resend'] : ['resend', 'revoke']) {
        const button = document.createElement('button'); button.type = 'button'; button.className = 'secondary'; button.dataset.action = action; button.dataset.id = row.id;
        button.textContent = action === 'resend' ? 'Resend' : 'Revoke'; button.setAttribute('aria-label', `${button.textContent} invitation for ${row.phone}`); actions.appendChild(button);
      }
      for (const item of [business, account, whatsapp, actions]) tr.appendChild(item); list.appendChild(tr);
    }
    empty.hidden = Boolean(rows.length); table.hidden = !rows.length;
    count.textContent = `${rows.length}${cursor ? '+' : ''} ${rows.length === 1 && !cursor ? 'business' : 'businesses'}`;
    pagination.hidden = !rows.length;
    pagination.dataset.singlePage = String(!cursor && rows.length <= pageSize);
    previous.disabled = loading || pageIndex === 0;
    more.disabled = loading || (start + pageSize >= rows.length && !cursor);
    range.textContent = `${start + 1}–${Math.min(start + pageSize, rows.length)} of ${rows.length}${cursor ? '+' : ''}`;
    table.scrollTop = resetScroll ? 0 : scrollTop;
  }
  compact.addEventListener('change', () => { const start = pageIndex * pageSize; pageSize = compact.matches ? 5 : 25; pageIndex = Math.floor(start / pageSize); render(true); });
  async function load(append = false) {
    if (loading || document.hidden) return;
    loading = true; setButtonBusy(refresh, true); setButtonBusy(more, append, true); table.setAttribute('aria-busy', 'true');
    try {
      const data = await api<{ items: InvitationRow[]; nextCursor: string | null; gatewayAvailable: boolean }>(`/api/invitations${append && cursor ? `?cursor=${encodeURIComponent(cursor)}` : ''}`);
      rows = append ? [...rows, ...data.items.filter((item: InvitationRow) => !rows.some((row) => row.id === item.id))] : data.items;
      if (append) pageIndex++;
      cursor = data.nextCursor; warning.hidden = data.gatewayAvailable; render(append);
    } catch (error) { message(error instanceof Error ? error.message : 'Couldn’t load users. Try again.', true); }
    finally { loading = false; setButtonBusy(refresh, false); more.setAttribute('aria-busy', 'false'); table.setAttribute('aria-busy', 'false'); if (rows.length) render(); else list.querySelectorAll<HTMLElement>('.user-checking').forEach(status => { status.classList.remove('user-checking'); status.textContent = 'Unavailable'; }); }
  }
  phone.addEventListener('input', () => { fieldError.hidden = true; phone.removeAttribute('aria-invalid'); if (feedback.classList.contains('success-feedback')) message(''); });
  form.addEventListener('submit', async (event) => {
    event.preventDefault(); if (sending) return;
    const input = localPhoneInput.safeParse(phone.value);
    if (!input.success) { fieldError.textContent = input.error.issues[0].message; fieldError.hidden = false; phone.setAttribute('aria-invalid', 'true'); phone.focus(); return; }
    if (pendingPhone !== input.data) { pendingPhone = input.data; requestId = crypto.randomUUID(); }
    sending = true; submit.disabled = true; wideSubmitLabel.textContent = 'Sending…'; compactSubmitLabel.textContent = 'Sending…'; form.setAttribute('aria-busy', 'true');
    message('Sending invitation...');
    try {
      const data = await api<{ message: string; deliveryStatus: string }>('/api/invitations', { phone: input.data, requestId });
      message(data.message, data.deliveryStatus !== 'sent', data.deliveryStatus === 'sent' ? 'Sent' : ''); phone.value = ''; pendingPhone = ''; requestId = crypto.randomUUID(); pageIndex = 0; table.scrollTop = 0; await load();
    } catch (error) { message(error instanceof Error && error.name !== 'TimeoutError' ? error.message : 'Sending could not be confirmed. Refresh the list before resending.', true); await load(); }
    finally { sending = false; submit.disabled = false; wideSubmitLabel.textContent = 'Send invitation'; compactSubmitLabel.textContent = 'Send'; form.removeAttribute('aria-busy'); }
  });
  list.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
    if (!button || button.disabled) return;
    const id = button.dataset.id!; const action = button.dataset.action!;
    const row = rows.find((entry) => entry.id === id);
    if (!row) return;
    if (!window.confirm(action === 'revoke' ? `Revoke the invitation for ${row.phone}?` : `Send a new invitation to ${row.phone}? The previous link will stop working.`)) return;
    setButtonBusy(button, true, false, action === 'revoke' ? 'Revoking...' : 'Sending...');
    message(action === 'revoke' ? 'Revoking invitation...' : 'Sending invitation...');
    const key = `${id}:${action}`;
    const requestId = actionRequests.get(key) ?? crypto.randomUUID(); actionRequests.set(key, requestId);
    try { const data = await api<{ message: string; deliveryStatus?: string }>(`/api/invitations/${id}`, action === 'revoke' ? { action } : { action, requestId }); message(data.message, Boolean(data.deliveryStatus && data.deliveryStatus !== 'sent'), action === 'revoke' ? 'Revoked' : data.deliveryStatus === 'sent' ? 'Sent' : ''); actionRequests.delete(key); }
    catch (error) { message(error instanceof Error ? error.message : 'Couldn’t update the invitation. Try again.', true); }
    finally { await load(); setButtonBusy(button, false); }
  });
  refresh.addEventListener('click', () => { pageIndex = 0; table.scrollTop = 0; void load(); });
  previous.addEventListener('click', () => { if (loading || !pageIndex) return; pageIndex--; render(true); });
  more.addEventListener('click', () => {
    if (loading) return;
    const nextPageIsCached = (pageIndex + 2) * pageSize <= rows.length || (!cursor && (pageIndex + 1) * pageSize < rows.length);
    if (nextPageIsCached) { pageIndex++; render(true); }
    else if (cursor) void load(true);
  });
  const timer = setInterval(() => { if (!document.hidden && !sending && !cursor && !pageIndex) void load(); }, 30000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden && !sending) void load(); });
  window.addEventListener('pagehide', () => clearInterval(timer));
  void load();
</script>
<style is:global>
  .users-page { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .users-page .page-heading h1 { margin-bottom: 6px; }
  .users-page .intro { margin: 0; }
  .users-grid { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(0, 2fr); gap: 24px; min-height: 0; }
  .invite-panel { align-self: start; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .invite-icon { display: block; width: 56px; height: 56px; margin: 0 auto 16px; color: var(--green); }
  .invite-panel h2, .list-heading h2 { margin: 0; font-size: 1.125rem; font-weight: 650; line-height: 1.4; letter-spacing: -.02em; }
  #invite-form { display: grid; gap: 16px; margin-top: 28px; }
  .phone-field { min-width: 0; }
  .send-label-compact { display: none; }
  .phone-field label { display: block; margin-bottom: 8px; font-size: .875rem; font-weight: 600; }
  .phone-field input { width: 100%; height: 48px; border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; color: var(--ink); background: var(--surface); font-size: 1rem; font-variant-numeric: tabular-nums; caret-color: var(--green); }
  .phone-field input:hover:not(:disabled) { border-color: var(--muted); }
  .phone-field input::placeholder { color: var(--muted); }
  .phone-field input[aria-invalid="true"] { border-color: var(--error); }
  #invite-error { margin: 8px 0 0; color: var(--error); font-size: .8125rem; }
  .invite-note { margin: 24px 0 0; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: .8125rem; line-height: 1.6; }
  .feedback { padding: 12px 14px; margin: 16px 0 0; background: var(--green-soft); border-radius: 8px; color: var(--green); font-size: .875rem; overflow-wrap: anywhere; }
  .feedback[data-error="true"] { background: #f7e7e2; color: var(--error); }
  .feedback.success-feedback { padding:0;background:transparent; }
  .gateway-warning { margin: 0; padding: 12px 20px; color: var(--muted); background: var(--paper); border-bottom: 1px solid var(--line); font-size: .8125rem; }
  .users-panel { display: flex; flex-direction: column; min-width: 0; min-height: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .list-heading { display: flex; justify-content: space-between; align-items: center; padding: 20px; gap: 16px; border-bottom: 1px solid var(--line); flex-shrink: 0; }
  .list-title { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; min-width: 0; }
  #users-count { color: var(--muted); font-size: .75rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .refresh-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; flex-shrink: 0; }
  .refresh-button svg { width: 16px; height: 16px; }
  .user-checking { display:inline-block;width:88px;height:12px;border-radius:6px;background:var(--line);color:transparent;animation:loading-skeleton-pulse 1.6s ease-in-out infinite; }
  @media(prefers-reduced-motion:reduce) { .user-checking { animation:none; } }
  .empty { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-height: 240px; padding: 40px 24px; text-align: center; }
  .empty h3 { font-size: 1rem; margin: 0 0 6px; }
  .empty p { margin: 0; color: var(--muted); font-size: .875rem; }
  .table-wrap { flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable; }
  .table-wrap:focus-visible { outline-offset: -3px; }
  .users-panel table { border-collapse: separate; border-spacing: 0; width: 100%; text-align: left; }
  .users-panel th { position: sticky; top: 0; z-index: 1; padding: 12px 16px; border-bottom: 1px solid var(--line); color: var(--muted); background: #fafbf9; font-size: .75rem; font-weight: 600; }
  .users-panel td { padding: 16px; border-bottom: 1px solid var(--line); vertical-align: middle; font-size: .875rem; overflow-wrap: anywhere; }
  .users-panel th:first-child, .users-panel td:first-child { padding-left: 20px; }
  .users-panel th:last-child, .users-panel td:last-child { padding-right: 20px; }
  .users-panel td:first-child { min-width: 140px; }
  .users-panel td strong { display: block; font-weight: 600; font-variant-numeric: tabular-nums; }
  .users-panel .detail { display: block; margin-top: 4px; color: var(--muted); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .users-panel .badge { display: inline-block; padding: 4px 10px; border-radius: 6px; color: var(--muted); background: var(--paper); font-size: .75rem; font-weight: 600; white-space: nowrap; }
  .users-panel .badge[data-active="true"] { color: var(--green); background: var(--green-soft); }
  .users-panel .whatsapp-cell { color: var(--muted); }
  .whatsapp-label { display: none; }
  .users-panel .actions { width: 1%; white-space: nowrap; text-align: right; }
  .actions button + button { margin-left: 8px; }
  .users-panel .actions .secondary { padding-inline: 12px; }
  .list-pagination { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 20px; margin: 0; border-top: 1px solid var(--line); }
  #page-range { color: var(--muted); font-size: .8125rem; font-variant-numeric: tabular-nums; }
  .list-pagination > div { display: flex; gap: 8px; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); }
  [hidden] { display: none !important; }
  @media (min-width: 1101px) and (min-height: 600px) {
    main:has(> .users-page) { display: flex; height: calc(100dvh - 64px); flex: none; }
    .users-page { flex: 1; min-height: 0; }
    .users-grid { flex: 1; }
    .invite-panel { align-self: stretch; display: flex; flex-direction: column; align-items: center; justify-content: safe center; }
    .invite-content { width: 100%; max-width: 360px; }
    .invite-icon { width: 80px; height: 80px; margin-bottom: 24px; }
    .invite-content h2, .invite-note { text-align: center; }
  }
  @media (max-width: 1100px), (max-height: 599px) {
    .users-grid { grid-template-columns: 1fr; }
    .invite-panel { padding: 20px; }
    #invite-form { grid-template-columns: minmax(0, 1fr) auto; align-items: start; margin-top: 20px; }
    #send-invite { margin-top: 30px; }
    .invite-note { margin-top: 20px; padding-top: 16px; }
    .users-panel { min-height: 360px; }
    .table-wrap { overflow: visible; scrollbar-gutter: auto; }
  }
  @media (max-width: 1000px) {
    .users-panel { min-height: 0; }
    .users-panel thead { position: absolute; clip-path: inset(50%); width: 1px; height: 1px; overflow: hidden; }
    .users-panel tbody { display: block; }
    .users-panel tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; padding: 20px; border-bottom: 1px solid var(--line); }
    .users-panel tr:last-child { border-bottom: 0; }
    .users-panel td { display: block; min-width: 0; padding: 0; border: 0; }
    .users-panel td:first-child { grid-column: 1; grid-row: 1 / span 2; min-width: 0; padding: 0; }
    .users-panel td:nth-child(2) { grid-column: 2; grid-row: 1; max-width: 130px; justify-self: end; text-align: right; }
    .users-panel td:last-child { padding: 0; }
    .users-panel .actions { display: flex; flex-wrap: wrap; gap: 8px; width: auto; grid-column: 1 / -1; grid-row: 3; margin-top: 8px; text-align: left; }
    .users-panel .actions:empty { display: none; }
    .actions button + button { margin-left: 0; }
