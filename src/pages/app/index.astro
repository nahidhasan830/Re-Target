---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import SetupDashboard from '../../components/SetupDashboard.astro';
import { currentAccount } from '../../lib/auth';
import { setupProgress } from '../../lib/setup-dashboard';
const account = await currentAccount(Astro.cookies);
if (!account) return Astro.redirect('/', 302);
if (account.role !== 'user') return Astro.redirect('/admin', 302);
if (Astro.request.method === 'POST') return Astro.redirect('/app/account', 307);
let progress = null;
try { progress = await setupProgress(account); }
catch { console.error(JSON.stringify({ event: 'setup_progress_failed' })); }
---
<DashboardLayout title="Dashboard" active="dashboard" role="user" phone={account.phone} companyName={account.companyName}>
  <SetupDashboard role="user" progress={progress} />
</DashboardLayout>
